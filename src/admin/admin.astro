---
// Dev-only (injected by astro.config.mjs when running `astro dev`).
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Vault Admin</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap">
</head>
<body class="adm-body">
    <header class="adm-bar">
        <strong class="adm-logo">Vault</strong>
        <span class="adm-git" id="gitInfo">…</span>
        <span class="adm-status" id="status" role="status"></span>
        <a class="adm-btn ghost" href="/" target="_blank" rel="noopener">View site ↗</a>
        <form class="adm-ship" id="shipForm">
            <input id="shipMsg" placeholder="What changed? (optional)" aria-label="Commit message">
            <button class="adm-btn primary" type="submit">Ship ▸</button>
        </form>
    </header>

    <nav class="adm-tabs" id="tabs" aria-label="Sections"></nav>

    <div class="adm-main">
        <aside class="adm-side" id="side"></aside>
        <section class="adm-editor" id="editor"></section>
    </div>

    <style is:global>
        /* rows/fields are built by JS, so scoped styles would miss them */
        .adm-body { display: block; min-height: 100vh; background: var(--bg); font-size: 14px; }
        .adm-body * { box-sizing: border-box; }
        .adm-bar {
            position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 0.75rem;
            padding: 0.6rem 1rem; background: #fff; border-bottom: 2px solid var(--border);
        }
        .adm-logo { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.04em; }
        .adm-git { font-size: 0.75rem; color: var(--text-muted); }
        .adm-git b { color: var(--text-primary); }
        .adm-git .warn { color: #b3261e; font-weight: 700; }
        .adm-status { margin-left: auto; font-size: 0.8rem; font-weight: 600; color: var(--accent); }
        .adm-status.err { color: #b3261e; }
        .adm-ship { display: flex; gap: 0.4rem; }
        .adm-ship input { width: 15rem; }
        .adm-btn {
            font: inherit; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
            padding: 0.45rem 0.85rem; border: 2px solid var(--border); background: #fff; color: var(--text-primary);
            cursor: pointer; text-decoration: none; white-space: nowrap; box-shadow: 2px 2px 0 var(--border);
        }
        .adm-btn:hover { background: var(--accent-sage); color: #fff; }
        .adm-btn.primary { background: var(--accent); color: #fff; }
        .adm-btn.ghost { box-shadow: none; }
        .adm-btn.danger { border-color: #b3261e; color: #b3261e; box-shadow: none; }
        .adm-btn.danger:hover { background: #b3261e; color: #fff; }
        .adm-btn.small { padding: 0.2rem 0.45rem; font-size: 0.68rem; box-shadow: none; }

        .adm-tabs { display: flex; gap: 0; padding: 0 1rem; border-bottom: 2px solid var(--border); background: var(--bg); }
        .adm-tab {
            font: inherit; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 0.6rem 1rem; border: none; background: none; cursor: pointer; color: var(--text-muted);
            border-bottom: 3px solid transparent; margin-bottom: -2px;
        }
        .adm-tab[aria-selected="true"] { color: var(--text-primary); border-bottom-color: var(--accent); }

        .adm-main { display: grid; grid-template-columns: 320px 1fr; min-height: calc(100vh - 100px); }
        .adm-main.wide { grid-template-columns: 1fr; }
        .adm-main.wide .adm-side { display: none; }
        .adm-side { border-right: 2px solid var(--border); padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
        .adm-side-tools { display: flex; gap: 0.4rem; }
        .adm-side-tools input { flex: 1; }
        .adm-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.3rem; overflow-y: auto; }
        .adm-row {
            display: grid; grid-template-columns: 1rem 1fr auto auto; gap: 0.45rem; align-items: center;
            padding: 0.45rem 0.55rem; background: #fff; border: 2px solid var(--border); cursor: pointer;
        }
        .adm-row.private { border-style: dashed; background: transparent; }
        .adm-row.private .adm-row-title { color: var(--text-muted); }
        .adm-row.sel { outline: 3px solid var(--accent); outline-offset: -1px; }
        .adm-row.drag-over { box-shadow: 0 -4px 0 var(--accent); }
        .adm-row-title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .adm-row-sub { display: block; font-size: 0.68rem; color: var(--text-muted); font-weight: 400; }
        .adm-grip { cursor: grab; color: var(--text-muted); user-select: none; }
        .adm-icon { border: none; background: none; cursor: pointer; font-size: 1rem; padding: 0 0.15rem; line-height: 1; opacity: 0.35; }
        .adm-icon.on { opacity: 1; }
        .adm-icon:hover { opacity: 1; }

        .adm-editor { padding: 1.25rem 1.5rem 4rem; max-width: 980px; }
        .adm-ed-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; flex-wrap: wrap; }
        .adm-ed-head h1 { font-size: 1.5rem; margin-right: auto; text-transform: none; letter-spacing: 0; }
        .adm-empty { color: var(--text-muted); padding: 3rem 0; }
        .adm-group { border: 2px solid var(--border); background: #fff; padding: 1rem 1.1rem; margin-bottom: 1rem; }
        .adm-group > h2 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); margin: 0 0 0.75rem; border: none; padding: 0; }
        .adm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem; }
        .adm-field { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.75rem; }
        .adm-field:last-child { margin-bottom: 0; }
        .adm-field > label, .adm-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); }
        .adm-hint { font-size: 0.72rem; color: var(--text-muted); }
        .adm-body input[type="text"], .adm-body input:not([type]), .adm-body input[type="url"], .adm-body textarea, .adm-body select {
            font: inherit; font-size: 0.9rem; padding: 0.45rem 0.55rem; border: 1.5px solid var(--border); background: #fff; width: 100%;
        }
        .adm-body textarea { resize: vertical; line-height: 1.5; }
        .adm-body textarea.code { font-family: ui-monospace, Consolas, monospace; font-size: 0.85rem; min-height: 22rem; }
        .adm-body input:focus, .adm-body textarea:focus, .adm-body select:focus { outline: 2px solid var(--accent); outline-offset: 0; }
        .adm-checks { display: flex; gap: 0.9rem; flex-wrap: wrap; }
        .adm-checks label { display: flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; cursor: pointer; }

        .adm-items { display: flex; flex-direction: column; gap: 0.35rem; }
        .adm-item { display: grid; grid-template-columns: 1fr auto; gap: 0.35rem; align-items: start; }
        .adm-item-cols { display: grid; gap: 0.35rem; grid-template-columns: var(--cols); }
        .adm-item-btns { display: flex; gap: 0.15rem; }

        .adm-media { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.6rem; }
        .adm-tile { position: relative; border: 2px solid var(--border); background: #111; aspect-ratio: 16 / 10; cursor: grab; }
        .adm-tile img, .adm-tile video { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
        .adm-tile.cover { outline: 3px solid var(--accent); outline-offset: 1px; }
        .adm-tile-badge { position: absolute; left: 4px; top: 4px; background: var(--accent); color: #fff; font-size: 0.6rem; font-weight: 700; padding: 1px 5px; text-transform: uppercase; }
        .adm-tile-btns { position: absolute; right: 4px; top: 4px; display: flex; gap: 3px; }
        .adm-tile-btns button { background: rgba(255,255,255,0.92); border: 1px solid var(--border); cursor: pointer; font-size: 0.75rem; padding: 0 5px; }
        .adm-tile-name { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); color: #fff; font-size: 0.62rem; padding: 2px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .adm-tile.drag-over { outline: 3px dashed var(--accent); }
        .adm-drop {
            border: 2px dashed var(--border); background: transparent; aspect-ratio: 16 / 10; display: flex; align-items: center;
            justify-content: center; text-align: center; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; padding: 0.5rem;
        }
        .adm-drop.hot, .adm-group.hot { background: rgba(107, 143, 71, 0.15); border-color: var(--accent); }
        .adm-todo { background: #fff8e1; border-color: #8a5a00; }
        .adm-todo > h2 { color: #8a5a00; }
        .adm-log { white-space: pre-wrap; font-size: 0.78rem; background: #fff; border: 2px solid var(--border); padding: 0.6rem; margin-top: 0.5rem; }
    </style>

    <script>
        // ════════════════════════════════════════════════════════════════════
        // Tiny DOM helper
        function h(tag, attrs = {}, ...kids) {
            const el = document.createElement(tag);
            for (const [k, v] of Object.entries(attrs || {})) {
                if (v === undefined || v === null || v === false) continue;
                if (k.startsWith('on')) el.addEventListener(k.slice(2).toLowerCase(), v);
                else if (k === 'class') el.className = v;
                else if (k === 'style') el.style.cssText = v;
                else if (k in el && typeof v !== 'string') el[k] = v;
                else el.setAttribute(k, v === true ? '' : v);
            }
            for (const kid of kids.flat()) if (kid !== null && kid !== undefined && kid !== false) el.append(kid);
            return el;
        }
        const $ = id => document.getElementById(id);
        const get = (obj, path) => path.split('.').reduce((o, k) => o?.[k], obj);
        function set(obj, path, val) {
            const keys = path.split('.'); const last = keys.pop();
            let o = obj; for (const k of keys) o = (o[k] ??= {});
            o[last] = val;
        }
        const slugify = s => String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        const isVideo = s => /\.(mp4|webm|ogg)$/i.test(s);
        const isImage = s => /\.(webp|png|jpe?g|gif|svg|avif)$/i.test(s);

        function setStatus(msg, err = false) {
            const el = $('status');
            el.textContent = msg;
            el.classList.toggle('err', err);
        }

        async function api(method, path, body) {
            const res = await fetch('/api/vault' + path, {
                method,
                headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
                body: body === undefined ? undefined : JSON.stringify(body),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || res.statusText);
            return data;
        }

        async function upload(file, kind, slug) {
            const res = await fetch('/api/vault/upload', {
                method: 'POST',
                headers: { 'x-kind': kind, 'x-slug': encodeURIComponent(slug || ''), 'x-filename': encodeURIComponent(file.name) },
                body: file,
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || res.statusText);
            return data.url;
        }

        // ════════════════════════════════════════════════════════════════════
        // Field specs per collection
        const DISCIPLINES = [['design', 'Design'], ['programming', 'Programming'], ['production', 'Production']];
        const VIS = { key: 'visibility', label: 'Visibility', type: 'select', options: [['private', 'Private (vault only)'], ['public', 'Public (on the site)']] };

        const SPECS = {
            projects: [
                { group: 'Basics', fields: [
                    { key: 'title', label: 'Title', type: 'text' },
                    { key: 'hook', label: 'Hook', type: 'textarea', rows: 2, hint: 'One line: what it is. Shown on cards and at the top of the page.' },
                    { row: [VIS, { key: 'featured', label: 'Featured on Home', type: 'bool' }] },
                    { key: 'disciplines', label: 'Shows off', type: 'checks', options: DISCIPLINES, hint: 'First checked = primary. Drives the Projects filter and /for/ pages.' },
                ]},
                { group: 'Fact box', grid: true, fields: [
                    { key: 'role', label: 'My role', type: 'text' },
                    { key: 'studio', label: 'Studio / context', type: 'text' },
                    { key: 'team', label: 'Team', type: 'text' },
                    { key: 'engine', label: 'Engine & languages', type: 'text' },
                    { key: 'duration', label: 'Duration', type: 'text' },
                    { key: 'status', label: 'Status', type: 'text' },
                ]},
                { group: 'Media', fields: [{ type: 'media' }] },
                { group: 'My contribution', fields: [{ key: 'contribution', type: 'list', placeholder: 'What I did, first person, specific', hint: '3–5 bullets. This is what recruiters read first.' }] },
                { group: 'Case study', fields: [{ type: 'body' }] },
                { group: 'Links & embed', fields: [
                    { key: 'links', type: 'rows', columns: [['label', 'Button text', '1fr'], ['url', 'https://…', '2fr']] },
                    { row: [
                        { key: 'embed.type', label: 'Embed', type: 'select', options: [['', 'None'], ['game', 'Playable (itch.io upload)'], ['widget', 'itch.io widget']] },
                        { key: 'embed.url', label: 'Embed URL', type: 'text' },
                    ]},
                ]},
                { group: 'Tags', fields: [{ key: 'tags', type: 'csv', hint: 'Comma separated. First three show on the strip header.' }] },
                { group: 'Notes to self', todo: true, fields: [{ key: 'todo', type: 'list', placeholder: 'Never shown on the site' }] },
            ],
            experience: [
                { group: 'Role', fields: [
                    { key: 'title', label: 'Title', type: 'text' },
                    { key: 'org', label: 'Organization', type: 'text' },
                    { row: [{ key: 'location', label: 'Location', type: 'text' }, { key: 'start', label: 'Start', type: 'text' }, { key: 'end', label: 'End', type: 'text' }] },
                    { row: [VIS] },
                    { key: 'disciplines', label: 'Shows off', type: 'checks', options: DISCIPLINES },
                ]},
                { group: 'Bullets', fields: [{ key: 'bullets', type: 'list', placeholder: 'Achievement or responsibility' }] },
                { group: 'Notes to self', todo: true, fields: [{ key: 'todo', type: 'list' }] },
            ],
            courses: [
                { group: 'Course', fields: [
                    { key: 'name', label: 'Name', type: 'text' },
                    { row: [VIS] },
                    { key: 'disciplines', label: 'Relevant to', type: 'checks', options: DISCIPLINES },
                ]},
            ],
            skills: [
                { group: 'Skill group', fields: [
                    { key: 'name', label: 'Group name', type: 'text' },
                    { row: [VIS, { key: 'wide', label: 'Full-width card on About', type: 'bool' }] },
                    { key: 'disciplines', label: 'Relevant to', type: 'checks', options: DISCIPLINES },
                ]},
                { group: 'Skills', fields: [{ key: 'items', type: 'list', placeholder: 'Skill' }] },
            ],
        };

        const SITE_SPEC = [
            { group: 'Home', fields: [
                { key: 'home.role', label: 'Title under your name', type: 'text' },
                { key: 'home.tagline', label: 'Tagline', type: 'textarea', rows: 2 },
                { key: 'home.openTo', label: 'Availability line', type: 'text' },
            ]},
            { group: 'About', fields: [
                { row: [{ key: 'about.name', label: 'Name', type: 'text' }, { key: 'about.title', label: 'Title', type: 'text' }] },
                { key: 'about.headshotUrl', label: 'Headshot', type: 'image' },
                { key: 'about.stats', label: 'Side panel facts', type: 'rows', columns: [['label', 'Label', '1fr'], ['value', 'Value', '2fr']] },
                { key: 'about.bio', label: 'Bio paragraphs', type: 'list', multiline: true },
                { key: 'about.lookingFor', label: 'What I\'m looking for', type: 'textarea', rows: 3 },
            ]},
            { group: 'Contact links', fields: [
                { key: 'contact.nodes', type: 'rows', columns: [['icon', '🔗', '3rem'], ['label', 'Label', '1fr'], ['handle', 'Shown text', '1.3fr'], ['href', 'https://… or mailto:', '2fr']] },
            ]},
            { group: 'Recruiter pages (/for/…)', fields: [
                { row: [{ key: 'lenses.design.title', label: 'Design title', type: 'text' }] },
                { key: 'lenses.design.summary', label: 'Design summary', type: 'textarea', rows: 3 },
                { row: [{ key: 'lenses.programming.title', label: 'Programming title', type: 'text' }] },
                { key: 'lenses.programming.summary', label: 'Programming summary', type: 'textarea', rows: 3 },
                { row: [{ key: 'lenses.production.title', label: 'Production title', type: 'text' }] },
                { key: 'lenses.production.summary', label: 'Production summary', type: 'textarea', rows: 3 },
            ]},
        ];

        const TABS = [
            ['projects', 'Projects'], ['experience', 'Experience'], ['courses', 'Courses'],
            ['skills', 'Skills'], ['site', 'Site text'], ['resumes', 'Resumes'],
        ];

        // ════════════════════════════════════════════════════════════════════
        // State
        let vault = {}, site = null, resumes = null;
        let tab = new URLSearchParams(location.hash.slice(1)).get('tab') || 'projects';
        let selected = new URLSearchParams(location.hash.slice(1)).get('id') || null;
        let draft = null;          // { id, data, body } being edited
        let saveTimer = null, pendingSave = null, dirty = false;

        const isMdTab = t => t === 'projects' || t === 'experience';
        const itemTitle = it => (isMdTab(tab) ? it.data?.title : it.name) || it.id;
        const itemData = it => (isMdTab(tab) ? it.data : it);

        function syncHash() {
            const p = new URLSearchParams({ tab });
            if (selected) p.set('id', selected);
            history.replaceState(null, '', '#' + p);
        }

        // ── Saving (debounced autosave) ──────────────────────────────────────
        function scheduleSave(delay = 700) {
            dirty = true;
            setStatus('Editing…');
            clearTimeout(saveTimer);
            saveTimer = setTimeout(flush, delay);
        }

        async function flush() {
            clearTimeout(saveTimer);
            saveTimer = null;
            if (!dirty) return pendingSave;
            dirty = false;
            const job = (async () => {
                try {
                    if (tab === 'site') {
                        for (const n of site.contact?.nodes ?? []) {
                            n.id ||= slugify(n.label || 'link');
                            n.cssClass ||= `node-${n.id}`;
                        }
                        await api('PUT', '/site', site);
                    } else if (tab === 'resumes') {
                        await api('PUT', '/resumes', resumes);
                    } else if (draft) {
                        await api('PUT', '/item', { collection: tab, id: draft.id, data: draft.data, body: draft.body });
                        const list = vault[tab];
                        const i = list.findIndex(x => x.id === draft.id);
                        if (i >= 0) list[i] = isMdTab(tab) ? structuredClone(draft) : { ...structuredClone(draft.data), id: draft.id };
                        renderSide();
                    }
                    setStatus('Saved ✓');
                    refreshGit();
                } catch (e) {
                    setStatus('Save failed: ' + e.message, true);
                }
            })();
            pendingSave = job;
            await job;
        }

        window.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); flush(); }
        });
        window.addEventListener('beforeunload', e => { if (saveTimer) { flush(); e.preventDefault(); } });

        // ── Git status / ship ────────────────────────────────────────────────
        let gitState = null;
        async function refreshGit() {
            try {
                gitState = await api('GET', '/git');
                const fmt = (name, r) => r ? [name + ': ', h('b', {}, r.branch), r.changed ? ` · ${r.changed} unsaved to git` : ' · clean'] : [];
                const live = gitState.site?.branch === 'main';
                $('gitInfo').replaceChildren(
                    ...fmt('site', gitState.site), '  |  ', ...fmt('vault', gitState.vault),
                    live ? h('span', { class: 'warn' }, '  · Ship deploys the LIVE site') : '',
                );
            } catch { $('gitInfo').textContent = 'git status unavailable'; }
        }

        $('shipForm').addEventListener('submit', async e => {
            e.preventDefault();
            if (gitState?.site?.branch === 'main' && !confirm('You are on main. Shipping will deploy these changes to the LIVE site. Continue?')) return;
            await flush();
            setStatus('Shipping…');
            try {
                const { log } = await api('POST', '/ship', { message: $('shipMsg').value });
                $('shipMsg').value = '';
                setStatus('Shipped ✓ ' + log.join(' · '));
            } catch (err) {
                setStatus('Ship failed: ' + err.message, true);
            }
            refreshGit();
        });

        // ════════════════════════════════════════════════════════════════════
        // Tabs + sidebar
        function renderTabs() {
            $('tabs').replaceChildren(...TABS.map(([key, label]) => {
                const count = vault[key] ? ` (${vault[key].filter(i => itemData(i)?.visibility === 'public' || i.visibility === 'public' || i.data?.visibility === 'public').length}/${vault[key].length})` : '';
                return h('button', {
                    class: 'adm-tab', type: 'button', 'aria-selected': String(key === tab),
                    onclick: async () => { await flush(); tab = key; selected = null; draft = null; renderAll(); },
                }, label + count);
            }));
            document.querySelector('.adm-main').classList.toggle('wide', tab === 'site' || tab === 'resumes');
        }

        let dragId = null;
        let filter = '';

        function renderSide() {
            if (tab === 'site' || tab === 'resumes') return;
            const list = vault[tab] ?? [];
            const newInput = h('input', { placeholder: tab === 'projects' ? 'New project title…' : 'New item name…', 'aria-label': 'New item name' });
            const create = async () => {
                const title = newInput.value.trim();
                if (!title) return newInput.focus();
                try {
                    await flush();
                    const { id } = await api('POST', '/item', { collection: tab, title });
                    vault = await api('GET', '/');
                    selected = id;
                    renderAll();
                    setStatus(`Created "${title}" (private)`);
                } catch (e) { setStatus(e.message, true); }
            };
            newInput.addEventListener('keydown', e => { if (e.key === 'Enter') create(); });

            const search = h('input', { placeholder: 'Search…', value: filter, 'aria-label': 'Search' });
            search.addEventListener('input', () => { filter = search.value.toLowerCase(); renderRows(); });

            const ul = h('ul', { class: 'adm-list' });
            function renderRows() {
                ul.replaceChildren(...list.filter(it => !filter || itemTitle(it).toLowerCase().includes(filter)).map(it => {
                    const d = itemData(it);
                    const pub = d.visibility === 'public';
                    const li = h('li', {
                        class: 'adm-row' + (pub ? '' : ' private') + (it.id === selected ? ' sel' : ''),
                        draggable: true,
                        onclick: async () => { await flush(); selected = it.id; renderSide(); renderEditor(); syncHash(); },
                    },
                        h('span', { class: 'adm-grip', 'aria-hidden': 'true' }, '⋮⋮'),
                        h('span', { class: 'adm-row-title' }, itemTitle(it),
                            h('span', { class: 'adm-row-sub' }, [(d.disciplines ?? []).join(' · '), d.todo?.length ? `${d.todo.length} todo` : ''].filter(Boolean).join('  ·  ') || it.id)),
                        tab === 'projects'
                            ? h('button', { class: 'adm-icon' + (d.featured ? ' on' : ''), title: d.featured ? 'Featured on Home' : 'Feature on Home', onclick: e => { e.stopPropagation(); quickToggle(it, 'featured', !d.featured); } }, '★')
                            : h('span'),
                        h('button', { class: 'adm-icon' + (pub ? ' on' : ''), title: pub ? 'Public: click to hide' : 'Private: click to publish', onclick: e => { e.stopPropagation(); quickToggle(it, 'visibility', pub ? 'private' : 'public'); } }, pub ? '👁' : '🚫'),
                    );
                    li.addEventListener('dragstart', () => { dragId = it.id; });
                    li.addEventListener('dragover', e => { e.preventDefault(); li.classList.add('drag-over'); });
                    li.addEventListener('dragleave', () => li.classList.remove('drag-over'));
                    li.addEventListener('drop', async e => {
                        e.preventDefault(); li.classList.remove('drag-over');
                        if (!dragId || dragId === it.id) return;
                        const ids = list.map(x => x.id).filter(x => x !== dragId);
                        ids.splice(ids.indexOf(it.id), 0, dragId);
                        list.sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
                        renderRows();
                        try { await api('POST', '/reorder', { collection: tab, ids }); setStatus('Order saved ✓'); refreshGit(); }
                        catch (err) { setStatus(err.message, true); }
                    });
                    return li;
                }));
            }
            renderRows();

            $('side').replaceChildren(
                h('div', { class: 'adm-side-tools' }, newInput, h('button', { class: 'adm-btn', type: 'button', onclick: create }, '+ Add')),
                search,
                ul,
                h('p', { class: 'adm-hint' }, 'Drag to reorder · 👁 public / 🚫 private · ★ featured on Home'),
            );
        }

        async function quickToggle(it, key, value) {
            await flush();
            const data = structuredClone(itemData(it));
            data[key] = value;
            const body = isMdTab(tab) ? it.body : undefined;
            try {
                await api('PUT', '/item', { collection: tab, id: it.id, data, body });
                if (isMdTab(tab)) it.data = data; else Object.assign(it, data);
                if (draft?.id === it.id) draft.data[key] = value;
                renderTabs(); renderSide(); if (draft?.id === it.id) renderEditor();
                setStatus(`${itemTitle(it)}: ${key === 'visibility' ? value : (value ? 'featured' : 'not featured')} ✓`);
                refreshGit();
            } catch (e) { setStatus(e.message, true); }
        }

        // ════════════════════════════════════════════════════════════════════
        // Field renderers. `root` is the object fields read/write (draft.data or site)
        function renderField(f, root, rerender) {
            const val = f.key ? get(root, f.key) : undefined;
            const onVal = v => { set(root, f.key, v); scheduleSave(); };
            const wrap = (control, extraHint) => h('div', { class: 'adm-field' },
                f.label ? h('label', {}, f.label) : null, control, f.hint || extraHint ? h('span', { class: 'adm-hint' }, f.hint || extraHint) : null);

            if (f.row) return h('div', { class: 'adm-grid' }, ...f.row.map(x => renderField(x, root, rerender)));

            switch (f.type) {
                case 'text': {
                    const i = h('input', { value: val ?? '', placeholder: f.placeholder || '' });
                    i.addEventListener('input', () => onVal(i.value));
                    return wrap(i);
                }
                case 'textarea': {
                    const t = h('textarea', { rows: f.rows || 3 }, val ?? '');
                    t.addEventListener('input', () => onVal(t.value));
                    return wrap(t);
                }
                case 'select': {
                    const s = h('select', {}, ...f.options.map(([v, l]) => h('option', { value: v, selected: (val ?? '') === v }, l)));
                    s.addEventListener('change', () => { onVal(s.value || undefined); if (f.key === 'visibility') { flush().then(() => { renderTabs(); renderSide(); }); } });
                    return wrap(s);
                }
                case 'bool': {
                    const c = h('input', { type: 'checkbox', checked: !!val });
                    c.addEventListener('change', () => onVal(c.checked));
                    return h('div', { class: 'adm-field' }, h('label', { class: 'adm-checks' }, h('label', {}, c, f.label)));
                }
                case 'checks': {
                    const cur = Array.isArray(val) ? val : [];
                    return wrap(h('div', { class: 'adm-checks' }, ...f.options.map(([v, l]) => {
                        const c = h('input', { type: 'checkbox', checked: cur.includes(v) });
                        c.addEventListener('change', () => {
                            const now = (get(root, f.key) ?? []).filter(x => x !== v);
                            if (c.checked) now.push(v);
                            onVal(now);
                        });
                        return h('label', {}, c, l);
                    })));
                }
                case 'csv': {
                    const i = h('input', { value: (val ?? []).join(', ') });
                    i.addEventListener('input', () => onVal(i.value.split(',').map(s => s.trim()).filter(Boolean)));
                    return wrap(i);
                }
                case 'list': return wrap(renderList(f, root, rerender));
                case 'rows': return wrap(renderRows(f, root, rerender));
                case 'image': return wrap(renderImage(f, root, rerender));
                case 'media': return renderMedia(root, rerender);
                case 'body': return renderBody();
            }
            return h('span');
        }

        function moveBtns(arr, i, rerender, onChange) {
            const move = d => { const j = i + d; if (j < 0 || j >= arr.length) return; [arr[i], arr[j]] = [arr[j], arr[i]]; onChange(); rerender(); };
            return h('div', { class: 'adm-item-btns' },
                h('button', { class: 'adm-btn small', type: 'button', title: 'Move up', onclick: () => move(-1) }, '↑'),
                h('button', { class: 'adm-btn small', type: 'button', title: 'Move down', onclick: () => move(1) }, '↓'),
                h('button', { class: 'adm-btn small danger', type: 'button', title: 'Remove', onclick: () => { arr.splice(i, 1); onChange(); rerender(); } }, '✕'),
            );
        }

        function renderList(f, root, rerender) {
            if (!Array.isArray(get(root, f.key))) set(root, f.key, []);
            const arr = get(root, f.key);
            const changed = () => scheduleSave();
            const add = () => { arr.push(''); changed(); rerender(); requestAnimationFrame(() => { const all = document.querySelectorAll(`[data-list="${f.key}"]`); all[all.length - 1]?.focus(); }); };
            return h('div', { class: 'adm-items' },
                ...arr.map((v, i) => {
                    const input = h('textarea', { rows: f.multiline ? 4 : 1, placeholder: f.placeholder || '', 'data-list': f.key }, v);
                    input.addEventListener('input', () => { arr[i] = input.value; changed(); });
                    input.addEventListener('keydown', e => { if (e.key === 'Enter' && !f.multiline && !e.shiftKey) { e.preventDefault(); add(); } });
                    return h('div', { class: 'adm-item' }, input, moveBtns(arr, i, rerender, changed));
                }),
                h('div', {}, h('button', { class: 'adm-btn small', type: 'button', onclick: add }, '+ Add')),
            );
        }

        function renderRows(f, root, rerender) {
            if (!Array.isArray(get(root, f.key))) set(root, f.key, []);
            const arr = get(root, f.key);
            const cols = f.columns.map(c => c[2]).join(' ');
            const changed = () => scheduleSave();
            return h('div', { class: 'adm-items' },
                ...arr.map((row, i) => h('div', { class: 'adm-item' },
                    h('div', { class: 'adm-item-cols', style: `--cols: ${cols}` }, ...f.columns.map(([k, ph]) => {
                        const inp = h('input', { value: row[k] ?? '', placeholder: ph });
                        inp.addEventListener('input', () => { row[k] = inp.value; changed(); });
                        return inp;
                    })),
                    moveBtns(arr, i, rerender, changed),
                )),
                h('div', {}, h('button', { class: 'adm-btn small', type: 'button', onclick: () => { arr.push({}); changed(); rerender(); } }, '+ Add')),
            );
        }

        function renderImage(f, root, rerender) {
            const val = get(root, f.key);
            const file = h('input', { type: 'file', accept: 'image/*', hidden: true });
            file.addEventListener('change', async () => {
                if (!file.files[0]) return;
                setStatus('Uploading…');
                try { set(root, f.key, await upload(file.files[0], 'site')); scheduleSave(0); rerender(); }
                catch (e) { setStatus(e.message, true); }
            });
            return h('div', { style: 'display:flex;gap:0.75rem;align-items:center' },
                val ? h('img', { src: val, alt: '', style: 'width:72px;height:72px;object-fit:cover;border:2px solid var(--border)' }) : null,
                h('button', { class: 'adm-btn', type: 'button', onclick: () => file.click() }, val ? 'Replace' : 'Upload'),
                file,
            );
        }

        // ── Media manager ────────────────────────────────────────────────────
        function renderMedia(root, rerender) {
            root.media ??= [];
            const media = root.media;
            const fileInput = h('input', { type: 'file', multiple: true, accept: 'image/*,video/*', hidden: true });

            async function addFiles(files) {
                files = [...files];
                for (const [n, f] of files.entries()) {
                    setStatus(`Uploading ${n + 1}/${files.length}: ${f.name}${f.size > 25e6 ? ' (large file, consider trimming)' : ''}`);
                    try {
                        const url = await upload(f, 'project', draft.id);
                        if (!media.includes(url)) media.push(url);
                        if (!root.image && isImage(url) && !url.endsWith('.gif')) root.image = url;
                    } catch (e) { setStatus(`${f.name}: ${e.message}`, true); return; }
                }
                await flush(); rerender();
                setStatus(`Uploaded ${files.length} file(s) ✓`);
            }
            fileInput.addEventListener('change', () => addFiles(fileInput.files));

            let dragIdx = null;
            const tiles = media.map((src, i) => {
                const isCover = root.image === src;
                const tile = h('div', { class: 'adm-tile' + (isCover ? ' cover' : ''), draggable: true, title: decodeURIComponent(src) },
                    isVideo(src) ? h('video', { src, muted: true, preload: 'metadata' }) : h('img', { src, alt: '', loading: 'lazy' }),
                    isCover ? h('span', { class: 'adm-tile-badge' }, 'Cover') : null,
                    h('div', { class: 'adm-tile-btns' },
                        !isVideo(src) && !isCover ? h('button', { type: 'button', title: 'Use as cover / card image', onclick: () => { root.image = src; scheduleSave(0); rerender(); } }, '★') : null,
                        h('button', { type: 'button', title: 'Remove from project', onclick: () => {
                            media.splice(i, 1);
                            if (root.image === src) root.image = media.find(m => !isVideo(m)) || '';
                            scheduleSave(0); rerender();
                        } }, '✕'),
                    ),
                    h('span', { class: 'adm-tile-name' }, decodeURIComponent(src.split('/').pop())),
                );
                tile.addEventListener('dragstart', e => { dragIdx = i; e.dataTransfer.effectAllowed = 'move'; });
                tile.addEventListener('dragover', e => { if (dragIdx !== null) { e.preventDefault(); tile.classList.add('drag-over'); } });
                tile.addEventListener('dragleave', () => tile.classList.remove('drag-over'));
                tile.addEventListener('drop', e => {
                    if (dragIdx === null) return;
                    e.preventDefault(); e.stopPropagation();
                    const [m] = media.splice(dragIdx, 1);
                    media.splice(i, 0, m);
                    dragIdx = null;
                    scheduleSave(0); rerender();
                });
                return tile;
            });

            const drop = h('div', { class: 'adm-drop', role: 'button', tabindex: '0', onclick: () => fileInput.click() },
                '+ Drop images / videos here', h('br'), '(or click)');

            const urlInput = h('input', { placeholder: 'Or paste a media URL / path and press Enter' });
            urlInput.addEventListener('keydown', e => {
                if (e.key !== 'Enter' || !urlInput.value.trim()) return;
                e.preventDefault();
                media.push(urlInput.value.trim());
                if (!root.image && isImage(urlInput.value)) root.image = urlInput.value.trim();
                scheduleSave(0); rerender();
            });

            const group = h('div', {},
                h('div', { class: 'adm-media' }, ...tiles, drop),
                h('p', { class: 'adm-hint', style: 'margin:0.5rem 0' }, 'Drag tiles to reorder (first = first in the gallery). ★ sets the cover used on cards and as the page hero. Images are converted to WebP automatically.'),
                urlInput, fileInput,
            );
            // Drop files anywhere on the Media group
            group.addEventListener('dragover', e => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); drop.classList.add('hot'); } });
            group.addEventListener('dragleave', e => { if (!group.contains(e.relatedTarget)) drop.classList.remove('hot'); });
            group.addEventListener('drop', e => {
                if (!e.dataTransfer.files.length) return;
                e.preventDefault(); drop.classList.remove('hot');
                addFiles(e.dataTransfer.files);
            });
            return group;
        }

        function renderBody() {
            const t = h('textarea', { class: 'code' }, draft.body ?? '');
            t.addEventListener('input', () => { draft.body = t.value; scheduleSave(); });
            const insert = (text) => { t.setRangeText(text, t.selectionStart, t.selectionEnd, 'end'); t.focus(); draft.body = t.value; scheduleSave(); };
            return h('div', {},
                h('div', { style: 'display:flex;gap:0.35rem;flex-wrap:wrap;margin-bottom:0.4rem' },
                    ...['Design', 'Process', 'Technical notes', 'Outcome and lessons'].map(s =>
                        h('button', { class: 'adm-btn small', type: 'button', onclick: () => insert(`\n## ${s}\n\n`) }, '+ ' + s)),
                    h('button', { class: 'adm-btn small', type: 'button', onclick: () => insert('- ') }, '• Bullet'),
                    h('button', { class: 'adm-btn small', type: 'button', onclick: () => insert('**bold**') }, 'B'),
                    h('button', { class: 'adm-btn small', type: 'button', onclick: () => insert('[text](https://)') }, 'Link'),
                ),
                t,
                h('p', { class: 'adm-hint' }, 'Markdown. Sections in recruiter order: Design (problem, goal, decision) → Process (prototypes, playtests, what changed) → Technical notes → Outcome and lessons.'),
            );
        }

        function renderGroups(spec, root, rerender) {
            return spec.map(g => h('div', { class: 'adm-group' + (g.todo ? ' adm-todo' : '') },
                h('h2', {}, g.group),
                ...(g.grid ? [h('div', { class: 'adm-grid' }, ...g.fields.map(f => renderField(f, root, rerender)))] : g.fields.map(f => renderField(f, root, rerender))),
            ));
        }

        // ════════════════════════════════════════════════════════════════════
        // Editor panel
        function renderEditor() {
            const ed = $('editor');
            if (tab === 'site') return renderSite();
            if (tab === 'resumes') return renderResumes();

            const it = (vault[tab] ?? []).find(x => x.id === selected);
            if (!it) {
                draft = null;
                ed.replaceChildren(h('p', { class: 'adm-empty' }, 'Pick something on the left, or add a new one.'));
                return;
            }
            if (!draft || draft.id !== it.id) {
                draft = isMdTab(tab) ? structuredClone(it) : { id: it.id, data: structuredClone(it) };
                delete draft.data.id;
            }
            const d = draft.data;
            const pub = d.visibility === 'public';
            const rerender = () => renderEditor();
            const viewHref = tab === 'projects' ? `/projects/${it.id}/` : tab === 'experience' ? '/about/' : '/about/';

            ed.replaceChildren(
                h('div', { class: 'adm-ed-head' },
                    h('h1', {}, d.title || d.name || it.id),
                    pub ? h('a', { class: 'adm-btn ghost', href: viewHref, target: '_blank', rel: 'noopener' }, 'View on site ↗') : h('span', { class: 'adm-hint' }, 'Private: not on the site'),
                    h('button', { class: 'adm-btn danger', type: 'button', onclick: async () => {
                        if (!confirm(`Delete "${d.title || d.name}"? (Projects/experience go to vault/_trash.)`)) return;
                        try {
                            clearTimeout(saveTimer); saveTimer = null;
                            await api('DELETE', '/item', { collection: tab, id: it.id });
                            vault = await api('GET', '/'); selected = null; draft = null; renderAll();
                            setStatus('Deleted ✓');
                        } catch (e) { setStatus(e.message, true); }
                    } }, 'Delete'),
                ),
                ...renderGroups(SPECS[tab], d, rerender),
            );
        }

        function renderSite() {
            const rerender = () => renderSite();
            $('editor').replaceChildren(
                h('div', { class: 'adm-ed-head' }, h('h1', {}, 'Site text'), h('span', { class: 'adm-hint' }, 'Changes save automatically.')),
                ...renderGroups(SITE_SPEC, site, rerender),
            );
        }

        function renderResumes() {
            const list = resumes.resumes;
            const rerender = () => renderResumes();
            const changed = () => scheduleSave(300);
            const disciplineSelect = r => {
                const s = h('select', {}, h('option', { value: '' }, 'General'), ...DISCIPLINES.map(([v, l]) => h('option', { value: v, selected: r.discipline === v }, l)));
                s.addEventListener('change', () => { r.discipline = s.value || undefined; changed(); });
                return s;
            };
            const rows = list.map((r, i) => {
                const label = h('input', { value: r.label ?? '' });
                label.addEventListener('input', () => { r.label = label.value; changed(); });
                const on = h('input', { type: 'checkbox', checked: !!r.enabled });
                on.addEventListener('change', () => { r.enabled = on.checked; changed(); });
                const file = h('input', { type: 'file', accept: 'application/pdf', hidden: true });
                file.addEventListener('change', async () => {
                    if (!file.files[0]) return;
                    setStatus('Uploading PDF…');
                    try { r.file = await upload(file.files[0], 'resume', r.id); changed(); rerender(); setStatus('PDF uploaded ✓'); }
                    catch (e) { setStatus(e.message, true); }
                });
                return h('div', { class: 'adm-group', style: 'display:grid;grid-template-columns:1.2fr 1fr auto auto auto;gap:0.6rem;align-items:center' },
                    label, disciplineSelect(r),
                    h('label', { class: 'adm-checks' }, h('label', {}, on, 'On the site')),
                    h('span', {}, r.file ? h('a', { href: r.file, target: '_blank', rel: 'noopener' }, 'PDF ↗') : 'no file', ' ',
                        h('button', { class: 'adm-btn small', type: 'button', onclick: () => file.click() }, r.file ? 'Replace PDF' : 'Upload PDF'), file),
                    moveBtns(list, i, rerender, changed),
                );
            });
            const newLabel = h('input', { placeholder: 'New resume label, e.g. "Level Design"' });
            $('editor').replaceChildren(
                h('div', { class: 'adm-ed-head' }, h('h1', {}, 'Resumes')),
                h('p', { class: 'adm-hint', style: 'margin-bottom:1rem' }, 'First resume that\'s on = the default tab on /resume/. A resume tied to a discipline is offered on that /for/ page. Uploading replaces the PDF in place.'),
                ...rows,
                h('div', { style: 'display:flex;gap:0.4rem;max-width:30rem' }, newLabel,
                    h('button', { class: 'adm-btn', type: 'button', onclick: () => {
                        const label = newLabel.value.trim(); if (!label) return newLabel.focus();
                        list.push({ id: slugify(label), label, file: '', enabled: false }); changed(); rerender();
                    } }, '+ Add')),
            );
        }

        function renderAll() {
            renderTabs();
            $('side').replaceChildren();
            renderSide();
            renderEditor();
            syncHash();
        }

        // ════════════════════════════════════════════════════════════════════
        // Links like /admin#tab=site&id=… work even on an already-open page
        window.addEventListener('hashchange', async () => {
            const p = new URLSearchParams(location.hash.slice(1));
            if ((p.get('tab') || 'projects') === tab && p.get('id') === selected) return;
            await flush();
            tab = p.get('tab') || 'projects';
            selected = p.get('id') || vault[tab]?.[0]?.id || null;
            draft = null;
            renderAll();
        });

        (async function init() {
            try {
                [vault, site, resumes] = await Promise.all([api('GET', '/'), api('GET', '/site'), api('GET', '/resumes')]);
                if (!selected && vault[tab]?.length) selected = vault[tab][0].id;
                renderAll();
                setStatus('Ready');
            } catch (e) {
                setStatus(`Couldn't load the vault: ${e.message}`, true);
            }
            refreshGit();
        })();
    </script>
</body>
</html>
