---
/*
 * Recruiter-specific landing pages: /for/design/, /for/programming/, /for/production/
 * Unlisted (noindex, not in nav or sitemap). Same body as Home with the role's
 * title and summary, featured work re-sorted for the lens, and the matching résumé.
 */
import Layout from '../../layouts/Layout.astro';
import HomeView from '../../components/HomeView.astro';
import { site } from '../../lib/view';
import { DISCIPLINES } from '../../content.config';
import type { Discipline } from '../../lib/content';

export function getStaticPaths() {
    return DISCIPLINES.map(lens => ({ params: { lens } }));
}

const lens = Astro.params.lens as Discipline;
const copy = site.lenses[lens];
---
<Layout title={`Rafaela Solís | ${copy.title}`} description={copy.summary} noindex>
    <HomeView lens={lens} />
</Layout>
