---
import Layout from '../../layouts/Layout.astro';
import { getProjects, projectMedia, isVideo, DISCIPLINE_LABELS } from '../../lib/content';
import { render } from 'astro:content';
import { washFor } from '../../lib/wash';

const projects = await getProjects();
const strips = await Promise.all(projects.map(async p => {
    const { Content } = await render(p);
    const media = projectMedia(p);
    const bgSrc = p.data.image || media.find(m => !isVideo(m)) || '';
    return { p, Content, media, bgSrc, wash: await washFor(bgSrc) };
}));
---
<Layout
    title="Projects | Rafaela Solís, Game Designer"
    description="Game projects by Rafaela Solís: design, programming, and production work in Unreal Engine 5, Unity, and OpenGL."
>
    <style is:global>
        :root {
            --compact-h: 36px; --compact-h-max: 48px;
            /* Lower-lip divider notch: left third drops to half the lip's
               height, then rises via a 45deg run back to the normal line —
               run == drop keeps the angle exactly 45deg regardless of the
               strip's actual (fluid) width. */
            --lip-drop: calc(var(--compact-h) / 2);
            --lip-line-thick: 1.5px;
        }

        .sections-stage {
            position: sticky;
            top: var(--nav-h);
            overflow: hidden;
        }

        /* ===== STRIP ===== */
        .section-strip {
            width: 100%;
            overflow: hidden;
            border-bottom: 2px solid var(--border);
            position: relative;
            background: var(--bg);
            display: flex;
            flex-direction: column;
            cursor: pointer;
            /* Above the fixed .strip-tab (z-index 1050): each strip is the
               "folder" the next strip's tab pokes up into the bottom of, and a
               folder always covers the tab of whatever's behind it wherever
               they overlap. Strips stay clipped to the stage's own box
               (overflow:hidden on .sections-stage) so this never lets a strip
               bleed into the nav bar above — only the tab itself is allowed to
               show there, in the empty space no strip ever paints into. */
            z-index: 1060;
        }

        /* ===== THUMBNAIL — absolute, covers full left side including header =====
           Always painted; the top/bottom buns (header + overview-row) sit above it
           at full opacity and occlude it while closed, so it is only ever seen
           through the gap the buns open up as the strip grows. Non-interactive
           (pointer-events) until the strip crosses the activation threshold. */
        .strip-thumbnail {
            position: absolute;
            top: 0; bottom: 0; left: 0;
            width: 58.33%; /* 7fr out of 12fr */
            z-index: 1;
            overflow: hidden;
            background: #111;
            pointer-events: none;
        }

        .section-strip.strip-active .strip-thumbnail { pointer-events: auto; }

        .strip-thumb-slide {
            position: absolute;
            inset: 0;
            display: none;
        }

        .strip-thumb-slide.active { display: block; }

        .strip-thumb-slide img {
            width: 100%; height: 100%;
            object-fit: cover; object-position: center; display: block;
        }

        .strip-thumb-slide video {
            width: 100%; height: 100%;
            object-fit: contain; background: #000; display: block;
        }

        .strip-thumbnail-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 3rem 2rem 1.75rem;
            background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.35) 55%, transparent 100%);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            z-index: 2;
            pointer-events: none;
        }

        /* ===== CAROUSEL CONTROLS ===== */
        .gallery-btn {
            position: absolute; top: 50%; transform: translateY(-50%);
            width: 64px; height: 64px;
            background: rgba(0,0,0,0.65); border: 1px solid rgba(255,255,255,0.25);
            color: #fff; font-size: 1.8rem; line-height: 1;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; z-index: 10; transition: background 0.15s; user-select: none;
        }

        .gallery-btn:hover { background: rgba(0,0,0,0.85); }
        .gallery-btn-prev { left: 0.4rem; }
        .gallery-btn-next { right: 0.4rem; }

        .gallery-counter {
            position: absolute; bottom: 0.55rem; right: 0.7rem;
            font-size: 0.62rem; font-weight: 600; color: rgba(255,255,255,0.45);
            pointer-events: none; font-variant-numeric: tabular-nums; letter-spacing: 0.04em;
            z-index: 10;
        }

        .strip-thumbnail-title {
            font-size: clamp(1.8rem, 2.8vw, 3rem);
            font-weight: 700;
            color: rgba(255,255,255,0.96);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            line-height: 1;
            text-shadow: 0 2px 16px rgba(0,0,0,0.5);
            /* Lifted up so the bottom bun (overview-row lip), which sits above this
               overlay at full strip height, doesn't clip into it. */
            margin-bottom: 1.5em;
        }

        /* ===== STRIP HEADER — top bun =====
           flex-basis 36px, grows a little (capped at --compact-h-max) to soak up
           small amounts of idle slack evenly with the bottom bun before content
           gets any — that keeps the closed look flush (no sliver of thumbnail
           peeking through) in the roomy at-rest state, while a real opening
           (hundreds of px of growth) blows straight past the cap and goes to
           content almost entirely, so the bun itself barely moves. */
        .strip-header {
            flex: 1 1 var(--compact-h);
            max-height: var(--compact-h-max);
            overflow: hidden;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0 0.85rem;
            position: relative;
            z-index: 2;
            background: var(--bg);
            transition: background 0.3s, backdrop-filter 0.3s;
        }

        .strip-title-group {
            position: absolute;
            left: 0; right: 0; top: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            overflow: hidden;
            pointer-events: none;
        }

        .section-strip.strip-active .strip-header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .strip-title {
            /* Title is drawn in .strip-tab on desktop; visually hidden here
               (not display:none) so screen readers and crawlers still get it */
            position: absolute; width: 1px; height: 1px; overflow: hidden;
            clip-path: inset(50%);
            font-size: 2rem; font-weight: 700; color: var(--text-primary);
            text-transform: uppercase; letter-spacing: 0.04em;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            line-height: 1;
        }

        /* EXPERIMENT: fills the header's title spot instead of text — roughly
           a third of the viewport wide, full header height, with an inset
           shadow on all sides for a recessed/sunken look. */
        .strip-hero-image {
            display: none; /* temporarily disabled */
            width: 33vw;
            max-width: 420px;
            height: 100%;
            background-size: cover;
            background-position: center;
            background-color: var(--accent-sage);
            box-shadow:
                inset 0 4px 10px rgba(0, 0, 0, 0.45),
                inset 0 -3px 8px rgba(0, 0, 0, 0.3),
                inset 4px 0 8px rgba(0, 0, 0, 0.25),
                inset -4px 0 8px rgba(0, 0, 0, 0.25);
        }

        .strip-hint {
            font-size: 0.6rem; color: var(--text-muted);
            flex-shrink: 0; line-height: 1;
        }

        .section-strip.strip-active .strip-hint { opacity: 0; }

        /* ===== HEADER TAGS (compact, inactive only) ===== */
        .strip-header-tags {
            display: flex;
            gap: 0.3rem;
            flex-shrink: 0;
            align-self: stretch;
            align-items: stretch;
            margin-left: auto;
            margin-right: 0.5rem;
            overflow: hidden;
            max-width: 50%;
            padding: 4px 0;
        }

        .strip-header-tag {
            font-size: 0.5rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.09em;
            background: var(--bg);
            border: 1.5px solid var(--border);
            padding: 0 0.5rem;
            color: var(--border);
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.3), inset 0 -1px 2px rgba(0,0,0,0.15);
            white-space: nowrap;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .section-strip.strip-active .strip-header-tags { opacity: 0; }

        /* ===== OVERVIEW ROW — bottom bun, mirrors the header (see note above) =====
           Own top-left corner is cut away (not just topped with a matching
           dip) so the ever-present .strip-thumbnail underneath shows through
           as a real recess — the socket the header's tab (which actually
           does add material, via .strip-notch-header) sits into. Without
           this cut, the row's own opaque fill would paint straight over that
           territory and no amount of stuff layered on top of it could ever
           reveal anything underneath.
           Permanent, same as the header's tab — open or resting, the recess
           stays cut. It's meant to read as a real socket the tab sits into,
           not a resting-only decoration, so it can't disappear the instant
           a strip grows. */
        .strip-overview-row {
            flex: 1 1 var(--compact-h);
            max-height: var(--compact-h-max);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0 0.85rem;
            position: relative;
            z-index: 2;
            background: var(--bg);
            overflow: hidden;
            clip-path: polygon(
                0 var(--lip-drop),
                0 100%,
                100% 100%,
                100% 0,
                calc(33.33% + var(--lip-drop)) 0,
                33.33% var(--lip-drop)
            );
            transition: background 0.3s, backdrop-filter 0.3s;
        }

        .section-strip.strip-active .strip-overview-row {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* ===== BUN NOTCH — makes each bun's own silhouette follow the
           shared divider shape instead of stopping in a flat rectangle at
           the seam =====
           Solid-filled wedge (left third dips a full var(--lip-drop), 45deg
           rise, zero-height for the rest) using the bun's own background —
           toggling with .strip-active exactly like the real header/
           overview-row — so it reads as that bun's own edge bulging past
           the seam, not a decal drawn on top of a flat one. Always anchored
           top:0 of its own box and dipping DOWNWARD from there — never
           mirrored between the two seams — so when the strip is closed
           (content height 0) the two seams land on the same y and the two
           wedges coincide as one edge.
           A plain child of .section-strip (not of the header/content/
           overview-row themselves) so it isn't clipped by any of their own
           overflow:hidden when it dips past a seam into the neighboring
           bun's territory. Positioned via JS every frame (top = headerH, or
           headerH+contentH) since the bun heights are computed there, not
           in CSS. */
        .strip-notch {
            position: absolute;
            left: 0; right: 0;
            height: var(--lip-drop);
            background: var(--bg);
            border-bottom: var(--lip-line-thick) solid rgba(26, 26, 26, 0.1);
            clip-path: polygon(
                0 0,
                100% 0,
                calc(33.33% + var(--lip-drop)) 0,
                33.33% var(--lip-drop),
                0 var(--lip-drop)
            );
            pointer-events: none;
            z-index: 3;
            transition: background 0.3s, backdrop-filter 0.3s, border-color 0.3s;
        }

        .section-strip.strip-active .strip-notch {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom-color: rgba(26, 26, 26, 0.15);
        }

        /* Lip notch: at rest (contentH ~0) it fully coincides with
           notch-header — the tab isn't just next to the socket, it's
           plugged into it, so there's nothing to see and this must render
           IDENTICAL to notch-header (falls through to the shared
           .strip-notch rules below, same opaque fill, same 0.14 wash) not
           its own competing translucent layer stacked on top of it. Turning
           it "cutout" (transparent, stronger wash, its own border) only
           makes sense once .strip-open — content has actually grown and the
           two notches have physically separated, so there's a real gap
           behind the lip for the cutout to reveal. z-index stays above
           notch-header unconditionally: harmless at rest since both look
           identical there, and needed while open so the (still positionally
           coincident-adjacent) elements never accidentally swap which one
           paints on top. */
        .strip-notch-lip {
            z-index: 4;
        }

        .section-strip.strip-open .strip-notch-lip,
        .section-strip.strip-active.strip-open .strip-notch-lip {
            background: transparent;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
        }

        /* The notch's diagonal run isn't a rectangle edge, so plain `border`
           can't trace it — a separate hairline rotated to match the exact
           45deg/lip-drop geometry of the clip-path polygon above, sitting on
           the same seam so it reads as that shape's own outline rather than
           a decal. Anchored at the polygon's own corner (33.33%, 0) so it
           tracks the notch's fluid width automatically. */
        .strip-notch::after {
            content: '';
            position: absolute;
            left: 33.33%; top: 0;
            width: calc(var(--lip-drop) * 1.41421356);
            height: var(--lip-line-thick);
            background: rgba(26, 26, 26, 0.1);
            transform-origin: left center;
            transform: rotate(45deg);
            pointer-events: none;
            transition: background 0.3s;
        }

        .section-strip.strip-active .strip-notch::after {
            background: rgba(26, 26, 26, 0.15);
        }

        /* The seam's flush run (everywhere right of the wedge, where the bun
           truly does end) — a plain child rather than a 3rd pseudo-element
           (::before is already the wash), kept off the notch's own box so
           the wedge itself stays seamless with the bun above/below it: no
           line should appear where the bun's own material is simply
           continuing down through the dip, only where it actually ends. */
        .strip-notch-flush {
            position: absolute;
            left: calc(33.33% + var(--lip-drop));
            right: 0; top: 0;
            height: var(--lip-line-thick);
            background: rgba(26, 26, 26, 0.1);
            pointer-events: none;
            transition: background 0.3s;
        }

        .section-strip.strip-active .strip-notch-flush {
            background: rgba(26, 26, 26, 0.15);
        }

        /* At rest, notch-lip coincides exactly with notch-header, and
           notch-header already draws all of border-bottom + ::after
           (diagonal) + .strip-notch-flush at that same position — so
           without this, the lip was drawing its own identical copy of all
           three stacked directly on top of the header's. Two coincident
           rgba(26,26,26,0.1) layers composite to ~0.19 alpha, not 0.1 — a
           border/diagonal/flush line that reads darker and more prominent
           than the same line anywhere else on the page for no visible
           reason. Silenced here (source order after every rule above wins
           the specificity ties) and only let through once .strip-open,
           when the two notches have actually separated and each genuinely
           needs its own outline. */
        .section-strip:not(.strip-open) .strip-notch-lip {
            /* border-COLOR only, never the border-bottom shorthand: style
               ("solid" -> "none") can't be transitioned, so it would pop
               on/off in one frame instead of fading — right around the
               contentH crossing this class flips on, i.e. exactly while a
               strip is opening/closing, which is when a hard pop reads as a
               flickering stray line. border-bottom-color fades smoothly
               through the existing `transition: border-color` above. */
            border-bottom-color: transparent;
        }
        .section-strip:not(.strip-open) .strip-notch-lip::after {
            background: transparent;
        }
        .section-strip:not(.strip-open) .strip-notch-lip .strip-notch-flush {
            background: transparent;
        }

        @media (max-width: 768px) {
            .strip-notch { display: none; }
            /* The corner cut is the desktop notch socket; with no notch on
               mobile it just clipped the start of the description. */
            .strip-overview-row { clip-path: none; }
            /* Nothing to show yet: skip the empty black media box */
            .section-strip.no-media .strip-thumbnail { display: none !important; }
        }

        /* ===== FOLDER TAB — bump on the strip's top edge, staggered per row =====
           Positioned by JS every frame (top tracks each strip's live cumulative
           offset, left cycles through TAB_STAGGER). Same fill/border as the card
           so it reads as a flap of the strip itself, not a separate chip.
           EXPERIMENT: holds the project title instead of the photo cutout —
           width hugs the text and grows rightward to fit it in full; capped
           at 90vw only as a safety net against overflowing the viewport. */
        .strip-tab {
            position: fixed;
            top: 0;
            width: fit-content;
            min-width: 90px;
            max-width: 90vw;
            height: 38px;
            background: var(--bg);
            border: 2px solid var(--border);
            border-bottom: none;
            border-radius: 10px 10px 0 0;
            z-index: 1050; /* above nav (1000), below play-overlay (1100) / lightbox (1200) */
            pointer-events: auto;
            cursor: pointer;
            transition: background 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 0 14px;
        }

        /* Project-image wash — same --wash-img (set per-strip and mirrored onto
           its tab from JS) blurred and washed out behind header, footer bun,
           and tab alike, so the whole collapsed row (tab included) reads as
           one tinted card instead of the tab looking like a separate flat
           chip. Sits behind each element's own text via normal paint order
           (::before content paints before its element's other children), on
           top of the plain --bg color underneath. Overscanned inset + the
           parent's own overflow:hidden keeps the blur from bleeding past the
           card's edges.
           background-attachment: fixed is the trick that makes the tab and
           the lip read as ONE irregular shape rather than two separate
           windows onto the same photo: with fixed attachment, size/position
           are computed against the viewport, not each box — so the header
           (in the sticky stage, viewport-pinned once stuck) and the tab
           (position: fixed, always viewport-pinned) are really just two
           differently-shaped holes cut into the exact same static image.
           Wherever they touch, the picture behind them lines up seamlessly,
           because it was never two pictures to begin with.
           Start opacity low — this is meant to be a hint, not a photo. */
        .strip-header::before,
        .strip-overview-row::before,
        .strip-tab::before,
        .strip-notch::before {
            content: '';
            position: absolute;
            inset: -16px;
            background-image: var(--wash-img);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            opacity: 0.14;
            pointer-events: none;
        }

        /* Bottom lip carries more of the project photo's color than the
           header/tab — it's the larger, carved-into shape now, so it reads
           better with a stronger wash than the thin top bun gets. */
        .strip-overview-row::before {
            opacity: 0.32;
        }

        /* notch-lip's own wash only boosts to that same 0.32 once
           .strip-open — at rest it must fall through to the shared 0.14
           (.strip-notch::before above) to stay identical to notch-header,
           for the same coincidence reason as the background rule above. */
        .section-strip.strip-open .strip-notch-lip::before {
            opacity: 0.32;
        }

        /* Flat, non-blurred color (not a backdrop-filter blur like the header
           uses) — the tab sits over whatever happens to be behind it (nav bar,
           a neighboring row), so a blur there would sample different content
           than the header's own blur and drift out of visual sync depending on
           position. A solid near-opaque match stays consistent everywhere. */
        .strip-tab.tab-active {
            background: rgba(255, 255, 255, 0.97);
        }

        .strip-tab-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            line-height: 1;
            white-space: nowrap;
            overflow: hidden;
        }

        @media (max-width: 768px) {
            .strip-tab { display: none; }
        }

        .strip-sep { width: 1px; height: 12px; background: rgba(26,26,26,0.2); flex-shrink: 0; }

        /* Subtitle moved up to the header bun's own top edge — the "lip" the
           folder tab pokes up from — left-aligned to the very first tab's
           stagger position rather than each strip's own cycling offset, so
           subtitles line up in one consistent column instead of jumping
           around with the tab stagger. The 34px offset (not 18px) accounts
           for the tab's own border + padding, landing under the first
           letter of the tab title itself rather than the tab box edge.
           Superseded by .strip-short-desc below on mobile, where there's no
           tab/lip and the old bottom placement is kept as part of the
           tappable bar. */
        .strip-lip-subtitle {
            position: absolute;
            left: 34px; top: 50%;
            transform: translateY(-50%);
            font-size: 1.0625rem; color: var(--text-secondary);
            white-space: nowrap;
            pointer-events: none;
            z-index: 4; /* above .strip-hero-image and .strip-notch */
            transition: opacity 0.15s ease-out;
        }

        @media (max-width: 768px) {
            .strip-lip-subtitle { display: none; }
        }

        .strip-short-desc {
            display: none;
            position: absolute;
            left: 0.85rem; right: 0.85rem; top: 0; bottom: 0;
            align-items: center; justify-content: center;
            overflow: hidden;
            font-size: 0.92rem; color: var(--text-secondary);
            pointer-events: none;
            z-index: 4; /* above .strip-notch */
            transition: opacity 0.15s ease-out;
        }
        .strip-short-desc > span {
            display: inline-block; max-width: 100%;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* ===== EXPANDED CONTENT — the "patty" between the two buns =====
           Always flex:1, so it fills whatever gap the header/footer buns
           leave as the strip grows — clipped to nothing when the buns are
           flush (closed), revealed as they separate. Non-interactive
           preview until the strip crosses the activation threshold. */
        .strip-content {
            flex: 1 1 0;
            position: relative; z-index: 2;
            overflow: hidden; display: flex;
            margin-left: 58.33%;
            pointer-events: none;
        }

        .section-strip.strip-active .strip-content { pointer-events: auto; }

        /* ===== INFO PANEL ===== */
        .strip-info {
            padding: 1.5rem 1.75rem;
            background: rgba(245, 242, 235, 0.97);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            display: flex; flex-direction: column; gap: 0.8rem;
            overflow-y: auto; border-left: 2px solid var(--border);
            width: 100%;
            /* Bold, self-contained scrollbar — signals this panel scrolls
               independently of the page's scroll-driven accordion engine. */
            scrollbar-width: auto;
            scrollbar-color: var(--accent) rgba(26, 26, 26, 0.1);
        }

        .strip-info::-webkit-scrollbar {
            width: 16px;
        }
        .strip-info::-webkit-scrollbar-track {
            background: rgba(26, 26, 26, 0.08);
            border-left: 2px solid var(--border);
        }
        .strip-info::-webkit-scrollbar-thumb {
            background-color: var(--accent);
            border: 4px solid rgba(245, 242, 235, 0.97);
            background-clip: padding-box;
        }
        .strip-info::-webkit-scrollbar-thumb:hover {
            background-color: var(--accent-sage);
        }

        .strip-label {
            font-size: 0.64rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.14em; color: var(--accent);
            padding-left: 0.5rem; border-left: 3px solid var(--accent);
        }

        .strip-description { font-size: 0.87rem; color: var(--text-secondary); line-height: 1.75; white-space: pre-line; }

        .strip-meta-row { display: flex; gap: 1.5rem; flex-wrap: wrap; }
        .strip-meta-item { display: flex; flex-direction: column; gap: 0.1rem; }
        .strip-meta-label { font-size: 0.59rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.13em; color: var(--accent); }
        .strip-meta-value { font-size: 0.8rem; color: var(--text-secondary); font-weight: 500; }

        .strip-tags-full { display: flex; flex-wrap: wrap; gap: 0.35rem; }

        .tag {
            font-size: 0.72rem; font-weight: 600;
            border: 2px solid var(--border); padding: 0.2rem 0.55rem;
            color: var(--text-primary);
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }

        .tag:hover { background: var(--accent); color: var(--bg); border-color: var(--accent); }

        .strip-link {
            display: inline-flex; align-items: center; gap: 0.5rem;
            background: var(--accent); color: var(--bg); text-decoration: none;
            padding: 0.65rem 1.4rem; border: 2px solid var(--border);
            box-shadow: 3px 3px 0 var(--border); font-weight: 700; font-size: 0.78rem;
            text-transform: uppercase; letter-spacing: 0.05em;
            transition: transform 0.15s, box-shadow 0.15s;
            align-self: flex-start; margin-top: auto; flex-shrink: 0;
        }

        .strip-link:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--border); }

        /* ===== EXPAND HINT ===== */
        #expandHint {
            position: absolute;
            top: 0; right: 0; bottom: 0;
            width: 30%;
            background: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.60) 50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            pointer-events: none;
            z-index: 20;
            opacity: 1;
            transition: opacity 0.5s ease;
        }

        #expandHint.hint-hidden { opacity: 0; }

        #expandHint .hint-mouse {
            width: 3.25rem;
            height: auto;
            color: #f5f2eb;
            filter: drop-shadow(0 2px 8px rgba(0,0,0,0.25));
        }

        @keyframes hintScroll {
            0%   { transform: translateY(0);    opacity: 1; }
            70%  { transform: translateY(10px); opacity: 0; }
            71%  { transform: translateY(0);    opacity: 0; }
            100% { transform: translateY(0);    opacity: 1; }
        }

        #expandHint .hint-wheel {
            animation: hintScroll 1.7s ease-in-out infinite;
        }

        #expandHint .hint-text {
            font-family: var(--font);
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            text-align: center;
            line-height: 1.55;
            color: #f5f2eb;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }

        /* ===== MOBILE =====
           No scroll-driven accordion here — instead every project is a
           compact, tappable bar (list view). Tapping one shows that
           project's full detail (thumbnail + info panel) and hides the
           rest; a sticky back bar returns to the list. */
        .mobile-back-bar { display: none; }

        @media (max-width: 768px) {
            #expandHint { display: none; }
            #scrollDriver { height: auto !important; }
            .sections-stage { position: static; height: auto !important; overflow: visible; }

            /* ── List view (default) — every strip is a compact bar ── */
            .section-strip {
                height: auto !important;
                min-height: 0;
                cursor: pointer;
                border-bottom: 2px solid var(--border);
                /* Desktop's z-index: 1060 (see base rule) only stays safely
                   below the nav/burger/mobile-menu stack (1000/1001) because
                   .sections-stage clips everything to its own box there. That
                   clipping is turned off for mobile's auto-height list just
                   above (overflow: visible), so the same 1060 would otherwise
                   paint every strip over the burger icon and the open
                   mobile-menu overlay the instant they occupy the same screen
                   space. Reset to the normal stacking order here. */
                z-index: auto;
            }
            .strip-header {
                background: var(--bg) !important;
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
                flex-wrap: wrap;
                flex-basis: auto !important;
                height: auto !important;
                max-height: none !important;
                min-height: 0;
                padding: 0.9rem 1rem;
                gap: 0.35rem 0.6rem;
            }
            /* The title is absolutely-centered for the desktop strip — on
               mobile let it flow normally so it doesn't sit on top of the
               tag chips when the header wraps to two lines. */
            .strip-header .strip-title-group {
                position: static;
                display: block;
                text-align: left;
                width: 100%;
            }
            .strip-title { display: block; font-size: 1.3rem; white-space: normal; }
            .strip-hero-image { display: none; } /* mobile keeps the plain text title */
            .strip-hint { display: none; } /* "scroll to expand" hint doesn't apply to a tap UI */
            .strip-header-tags { max-width: 100%; }

            /* Short description stays visible as part of the bar */
            .strip-overview-row {
                flex-basis: auto !important;
                max-height: none !important;
                height: auto !important;
                display: flex !important;
                padding: 0 1rem 0.9rem;
                border-top: none !important;
            }
            .strip-short-desc { position: static; display: block; }
            .strip-short-desc > span { white-space: normal; }

            /* Detail content stays hidden until a bar is tapped open */
            .strip-thumbnail, .strip-content { display: none; }

            /* ── Detail view — one project open ── */
            body.mobile-project-open .section-strip:not(.mobile-open) { display: none; }

            /* Base .section-strip/.strip-content both have overflow:hidden
               for the desktop accordion, where it's needed to clip a strip
               to its scroll-computed height. On mobile there's no such
               height budget — content should grow the page and let it
               scroll normally, not get clipped to whatever min-height
               happened to be guessed. */
            .section-strip.mobile-open { cursor: default; border-bottom: 3px solid var(--border); overflow: visible; }
            .section-strip.mobile-open .strip-overview-row { display: none !important; }

            .section-strip.mobile-open .strip-thumbnail {
                display: block;
                /* was position:static — the thumb slides are absolutely
                   positioned (inset:0) and need THIS box, not the whole
                   card, as their containing block or they render at the
                   card's full height and get cropped down to nothing. */
                position: relative;
                width: 100%; height: 260px;
                pointer-events: auto !important;
            }
            .section-strip.mobile-open .strip-content {
                display: flex;
                /* Desktop's flex-basis:0 stays in the cascade otherwise —
                   with overflow:visible that doesn't clip content, it just
                   lets it paint past this box without growing it, which is
                   what was pushing the footer up into the middle of the
                   text below. Force it to size to its own content instead,
                   same as the header/overview-row overrides above. */
                flex: 0 0 auto !important;
                overflow: visible;
                margin-left: 0;
                min-height: calc(100svh - 300px);
                pointer-events: auto !important;
            }
            .strip-info { border-left: none; overflow-y: visible; }

            /* ── Back bar ── */
            .mobile-back-bar {
                position: sticky; top: 0; z-index: 40;
                width: 100%;
                align-items: center; gap: 0.6rem;
                padding: 0.85rem 4.5rem 0.85rem 1rem;
                background: rgba(255,255,255,0.92);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: none; border-bottom: 2px solid var(--border);
                font-family: inherit; font-weight: 700; text-transform: uppercase;
                letter-spacing: 0.06em; font-size: 0.8rem; color: var(--text-primary);
                cursor: pointer;
            }
            body.mobile-project-open .mobile-back-bar { display: flex; }
            .mobile-back-arrow { font-size: 1.1rem; line-height: 1; color: var(--accent); }
        }

        /* ===== LIGHTBOX ===== */
        .lightbox {
            position: fixed; inset: 0; z-index: 1200;
            background: rgba(0,0,0,0.95);
            display: flex; flex-direction: column;
            align-items: stretch; justify-content: center;
            padding: 1.75rem;
            gap: 0.75rem;
        }
        .lightbox-header {
            display: flex; align-items: center; gap: 1rem; flex-shrink: 0;
        }
        .lightbox-title {
            flex: 1; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.14em; color: rgba(255,255,255,0.55);
        }
        .lightbox-counter {
            font-size: 0.75rem; color: rgba(255,255,255,0.4);
            font-weight: 600; letter-spacing: 0.06em;
        }
        .lightbox-close {
            background: none; border: 2px solid rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.7); cursor: pointer;
            padding: 0.35rem 0.85rem; font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.08em; font-family: inherit;
            transition: border-color 0.15s, color 0.15s;
        }
        .lightbox-close:hover { border-color: #fff; color: #fff; }
        .lightbox-body {
            flex: 1; min-height: 0;
            display: flex; align-items: center; justify-content: center;
            position: relative;
        }
        .lightbox-media {
            max-width: 100%; max-height: 100%;
            object-fit: contain; display: block;
        }
        .lightbox-media-video {
            max-width: 100%; max-height: 100%;
            display: block; outline: none;
        }
        .lightbox-nav {
            position: absolute; top: 50%; transform: translateY(-50%);
            background: rgba(255,255,255,0.08); border: 2px solid rgba(255,255,255,0.2);
            color: #fff; cursor: pointer; font-size: 1.25rem; line-height: 1;
            padding: 0.6rem 0.9rem; transition: background 0.15s, border-color 0.15s;
        }
        .lightbox-nav:hover { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.5); }
        .lightbox-nav-prev { left: 0; }
        .lightbox-nav-next { right: 0; }
        /* make thumbnail clickable */
        .strip-thumbnail { cursor: zoom-in; }

        /* ===== GAME EMBED OVERLAY ===== */
        .play-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.92);
            z-index: 1100; /* above nav (1000) */
            display: flex; flex-direction: column;
            align-items: stretch;
            justify-content: center;
            padding: 1.75rem 1.75rem 5rem; /* extra bottom room for itch.io footer bar */
            gap: 0.75rem;
        }

        .play-overlay-header {
            display: flex; align-items: center; gap: 1rem;
            flex-shrink: 0;
        }

        .play-overlay-title {
            flex: 1; font-size: 0.8rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.14em;
            color: rgba(255,255,255,0.55);
        }

        .play-close-btn {
            background: none; border: 2px solid rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.7); cursor: pointer;
            padding: 0.35rem 0.85rem; font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.08em; font-family: inherit;
            transition: border-color 0.15s, color 0.15s;
        }
        .play-close-btn:hover { border-color: #fff; color: #fff; }
        .play-fs-btn {
            background: none; border: 2px solid rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.7); cursor: pointer;
            padding: 0.35rem 0.85rem; font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.08em; font-family: inherit;
            transition: border-color 0.15s, color 0.15s;
        }
        .play-fs-btn:hover { border-color: #fff; color: #fff; }

        .play-iframe-wrap {
            /* Widest possible 16:9 box that fits within the viewport height.
               max-width caps the width so height = width*(9/16) never exceeds that. */
            width: 100%;
            max-width: calc((100vh - 8.75rem) * 16 / 9);
            aspect-ratio: 16 / 9;
            align-self: center;
            background: #000;
            border: 3px solid var(--border);
            position: relative;
            overflow: visible;   /* lets the itch.io footer bar hang below the border */
        }
        .play-iframe-wrap iframe {
            position: absolute; top: 0; left: 0;
            border: none; display: block;
            transform-origin: top left;
        }

        /* Play Now button in info panel */
        .strip-play-btn {
            display: inline-flex; align-items: center; gap: 0.45rem;
            background: transparent; color: var(--accent); text-decoration: none;
            padding: 0.65rem 1.4rem; border: 2px solid var(--accent);
            box-shadow: 3px 3px 0 var(--accent); font-weight: 700; font-size: 0.78rem;
            text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer;
            font-family: inherit;
            transition: transform 0.15s, box-shadow 0.15s, background 0.15s, color 0.15s;
            align-self: flex-start; flex-shrink: 0;
        }
        .strip-play-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0 var(--accent);
            background: var(--accent); color: var(--bg);
        }

        /* ===== FILTERS ===== */
        .project-filters {
            position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 1100;
            display: flex; align-items: center; gap: 0.35rem;
            background: var(--bg); border: 2px solid var(--border);
            box-shadow: 4px 4px 0 var(--border); padding: 0.4rem 0.5rem;
        }
        .project-filters-label {
            font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.14em; color: var(--text-muted); padding: 0 0.35rem;
        }
        .project-filter {
            font-family: inherit; font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer;
            background: transparent; color: var(--text-primary);
            border: 2px solid var(--border); padding: 0.3rem 0.7rem;
            transition: background 0.15s, color 0.15s;
        }
        .project-filter:hover { background: var(--accent-sage); color: var(--bg); }
        .project-filter[aria-pressed="true"] { background: var(--accent); color: var(--bg); }
        .section-strip[hidden], .strip-tab[hidden] { display: none !important; }

        /* Rendered markdown + contribution list inside an open strip */
        .strip-body { font-size: 0.87rem; color: var(--text-secondary); line-height: 1.75; display: flex; flex-direction: column; gap: 0.65rem; }
        .strip-body > * { margin: 0; }
        .strip-body h2 {
            font-size: 0.64rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.14em; color: var(--accent);
            padding-left: 0.5rem; border-left: 3px solid var(--accent); margin-top: 0.4rem;
        }
        .strip-body ul, ul.strip-body { padding-left: 1.2rem; gap: 0.2rem; }
        .strip-body a { color: var(--accent); }
        .strip-meta-row dd { margin: 0; }
        .strip-actions { display: flex; gap: 0.65rem; flex-wrap: wrap; align-items: flex-start; margin-top: auto; padding-top: 0.5rem; }
        .strip-link-secondary { background: transparent; color: var(--accent); border-color: var(--accent); box-shadow: 3px 3px 0 var(--accent); }
        .strip-link-secondary:hover { box-shadow: 5px 5px 0 var(--accent); }

        @media (max-width: 768px) {
            .project-filters {
                position: static; flex-wrap: wrap; box-shadow: none;
                border-width: 0 0 2px; padding: 0.75rem 1rem;
                margin-top: calc(var(--nav-h) + 0.5rem);
            }
            /* Mobile shows the strip's own h2 as the visible list title */
            .strip-title.strip-title {
                position: static; width: auto; height: auto; margin: 0;
                overflow: visible; clip-path: none;
            }
        }
    </style>

    <h1 class="sr-only">Projects</h1>
    <div class="project-filters" role="group" aria-label="Filter projects by discipline">
        <span class="project-filters-label">Focus</span>
        <button type="button" class="project-filter" data-filter="all" aria-pressed="true">All</button>
        {Object.entries(DISCIPLINE_LABELS).map(([key, label]) => (
            <button type="button" class="project-filter" data-filter={key} aria-pressed="false">{label}</button>
        ))}
    </div>

    <main id="scrollDriver">
        <button id="mobileBackBar" class="mobile-back-bar" type="button">
            <span class="mobile-back-arrow">&#8592;</span>
            <span class="mobile-back-label">All Projects</span>
        </button>
        <div class="sections-stage" id="sectionsStage">
            {strips.map(({ p, Content, media, bgSrc, wash }, i) => (
                <article
                    class:list={["section-strip", { "no-media": media.length === 0 }]}
                    id={`strip-${i}`}
                    data-slug={p.id}
                    data-title={p.data.title}
                    data-disciplines={p.data.disciplines.join(' ')}
                    data-wash={wash}
                    data-media={JSON.stringify(media)}
                    aria-labelledby={`strip-title-${i}`}
                >
                    <div class="strip-thumbnail">
                        {media.map((src, idx) => {
                            const eager = i === 0 && idx === 0;
                            return (
                                <div class:list={['strip-thumb-slide', { active: idx === 0 }]}>
                                    {isVideo(src)
                                        ? <video src={eager ? src : undefined} data-src={eager ? undefined : src} controls muted playsinline loop preload="none"></video>
                                        : <img src={eager ? src : undefined} data-src={eager ? undefined : src} alt={`${p.data.title} screenshot ${idx + 1}`} loading="lazy" />}
                                </div>
                            );
                        })}
                        <div class="strip-thumbnail-overlay">
                            <span class="strip-thumbnail-title" aria-hidden="true">{p.data.title}</span>
                        </div>
                        {media.length > 1 && (
                            <Fragment>
                                <button class="gallery-btn gallery-btn-prev" aria-label="Previous image">&#8592;</button>
                                <button class="gallery-btn gallery-btn-next" aria-label="Next image">&#8594;</button>
                                <span class="gallery-counter"><span class="gallery-cur">1</span> / {media.length}</span>
                            </Fragment>
                        )}
                    </div>
                    <div class="strip-header">
                        <span class="strip-lip-subtitle">{p.data.hook}</span>
                        <div class="strip-title-group">
                            <h2 class="strip-title" id={`strip-title-${i}`}>{p.data.title}</h2>
                            <div class="strip-hero-image" style={bgSrc ? `background-image: url('${bgSrc}')` : undefined}></div>
                        </div>
                        {p.data.tags.length > 0 && (
                            <div class="strip-header-tags">
                                {p.data.tags.slice(0, 3).map(t => <span class="strip-header-tag">{t}</span>)}
                            </div>
                        )}
                        <span class="strip-hint" aria-hidden="true">&#8597;</span>
                    </div>
                    <div class="strip-notch strip-notch-header"><span class="strip-notch-flush"></span></div>
                    <div class="strip-content">
                        <div class="strip-info">
                            <dl class="strip-meta-row">
                                {[['Role', p.data.role], ['Team', p.data.team], ['Engine', p.data.engine], ['Duration', p.data.duration], ['Status', p.data.status]]
                                    .filter(([, v]) => v)
                                    .map(([k, v]) => (
                                        <div class="strip-meta-item"><dt class="strip-meta-label">{k}</dt><dd class="strip-meta-value">{v}</dd></div>
                                    ))}
                            </dl>
                            <div class="strip-tags-full">{p.data.tags.map(t => <span class="tag">{t}</span>)}</div>
                            {p.data.contribution.length > 0 && (
                                <Fragment>
                                    <span class="strip-label">My contribution</span>
                                    <ul class="strip-body strip-contribution">{p.data.contribution.map(c => <li>{c}</li>)}</ul>
                                </Fragment>
                            )}
                            <div class="strip-body"><Content /></div>
                            <div class="strip-actions">
                                <a href={`/projects/${p.id}/`} class="strip-link">Full case study &rarr;</a>
                                {p.data.links.map(l => (
                                    <a href={l.url} class="strip-link strip-link-secondary" target="_blank" rel="noopener noreferrer">{l.label} &#8599;</a>
                                ))}
                                {p.data.embed?.type === 'game' && (
                                    <button class="strip-play-btn" data-embed={p.data.embed.url} data-title={p.data.title}>&#9654; Play Now</button>
                                )}
                            </div>
                        </div>
                    </div>
                    <div class="strip-notch strip-notch-lip"><span class="strip-notch-flush"></span></div>
                    <div class="strip-overview-row">
                        <span class="strip-short-desc"><span>{p.data.hook}</span></span>
                    </div>
                </article>
            ))}
        </div>
    </main>

    <!-- ── GAME EMBED OVERLAY ── -->
    <!-- ── LIGHTBOX ── -->
    <div id="lightbox" class="lightbox" style="display:none">
        <div class="lightbox-header">
            <span class="lightbox-title" id="lbTitle"></span>
            <span class="lightbox-counter" id="lbCounter"></span>
            <button class="lightbox-close" id="lbClose">✕ Close</button>
        </div>
        <div class="lightbox-body" id="lbBody">
            <button class="lightbox-nav lightbox-nav-prev" id="lbPrev">&#8592;</button>
            <button class="lightbox-nav lightbox-nav-next" id="lbNext">&#8594;</button>
        </div>
    </div>

    <div id="playOverlay" class="play-overlay" style="display:none">
        <div class="play-overlay-header">
            <span class="play-overlay-title" id="playOverlayTitle"></span>
            <button class="play-fs-btn" id="playFsBtn">⛶ Fullscreen</button>
            <button class="play-close-btn" id="playCloseBtn">✕ Close</button>
        </div>
        <div class="play-iframe-wrap">
            <iframe id="playIframe" allowfullscreen
                allow="autoplay; fullscreen *; encrypted-media; gamepad"></iframe>
        </div>
    </div>

    <script>
        const NAV_H     = 60;
        const BUN_MAX   = 48; // header/footer bun cap in px — must match --compact-h-max
        const SUBTITLE_FADE_HI = BUN_MAX * 0.75; // bun height at/above which the subtitle is fully shown
        const SUBTITLE_FADE_LO = BUN_MAX * 0.35; // bun height at/below which the subtitle is fully hidden
        function subtitleFadeOpacity(bunH) {
            const range = SUBTITLE_FADE_HI - SUBTITLE_FADE_LO;
            return range > 0
                ? Math.max(0, Math.min(1, (bunH - SUBTITLE_FADE_LO) / range))
                : (bunH >= SUBTITLE_FADE_HI ? 1 : 0);
        }
        const BUF_VH    = 0.25;
        const SEC_VH    = 0.80;
        const HERO_HOLD = 0.25;
        const HERO_FRAC = 0.80;
        const TAB_STAGGER = [18, 96, 174, 252]; // cycling left offsets (px) for folder-tab stagger
        const TAB_H       = 34; // visible poke height above the strip's top edge (tab height 38px minus a 4px tuck hidden under the strip)

        let isMobile = false;

        function checkMobile() {
            isMobile = window.matchMedia('(max-width: 768px)').matches;
        }

        function isVideo(src) {
            return /\.(mp4|webm|ogg)$/i.test(src);
        }

        // Strips that survive the current discipline filter, in page order
        function visibleStrips() {
            return Array.from(document.querySelectorAll('#sectionsStage .section-strip:not([hidden])'));
        }

        function sizeStage() {
            const stage  = document.getElementById('sectionsStage');
            const driver = document.getElementById('scrollDriver');
            const slotSize = 1 + HERO_HOLD;
            stage.style.height  = (window.innerHeight - NAV_H) + 'px';
            driver.style.height = ((BUF_VH + visibleStrips().length * slotSize * SEC_VH) * window.innerHeight) + 'px';
        }

        // Strips are rendered at build time (so crawlers and no-JS readers get
        // every project); this only wires up behavior and the fixed folder tabs.
        function initStrips() {
            const stage  = document.getElementById('sectionsStage');
            const strips = Array.from(stage.querySelectorAll('.section-strip'));
            sizeStage();

            strips.forEach((strip, i) => {
                const title = strip.dataset.title;
                const media = JSON.parse(strip.dataset.media || '[]');
                // Pre-blurred at build time (src/lib/wash.ts) and inlined as a
                // data URI, so no live CSS blur and no URL-resolution pitfalls
                const washImg = strip.dataset.wash || 'linear-gradient(135deg, #2d5016, #6b8f47)';
                strip.style.setProperty('--wash-img', washImg);

                // Lightbox: click thumbnail to expand
                const thumb = strip.querySelector('.strip-thumbnail');
                const slides = Array.from(thumb.querySelectorAll('.strip-thumb-slide'));
                thumb.addEventListener('click', e => {
                    if (e.target.closest('.gallery-btn') || !media.length) return; // ignore nav arrow clicks
                    const active = thumb.querySelector('.strip-thumb-slide.active');
                    openLightbox(media, active ? slides.indexOf(active) : 0, title);
                });

                if (slides.length > 1) {
                    const curEl = thumb.querySelector('.gallery-cur');
                    let cur = 0;

                    function goTo(idx) {
                        slides[cur].classList.remove('active');
                        cur = (idx + slides.length) % slides.length;
                        slides[cur].classList.add('active');
                        if (curEl) curEl.textContent = cur + 1;
                    }

                    thumb.querySelector('.gallery-btn-prev').addEventListener('click', e => { e.stopPropagation(); goTo(cur - 1); });
                    thumb.querySelector('.gallery-btn-next').addEventListener('click', e => { e.stopPropagation(); goTo(cur + 1); });
                }

                const jumpOrOpen = e => {
                    if (isMobile) {
                        if (strip.classList.contains('mobile-open')) return;
                        openMobileProject(strip);
                        return;
                    }
                    if (e.target.closest('a, button')) return; // links/buttons inside an open strip do their own thing
                    if (strip.classList.contains('strip-active')) return;
                    const slot = visibleStrips().indexOf(strip);
                    const slotSize = 1 + HERO_HOLD;
                    window.scrollTo({ top: BUF_VH * window.innerHeight + slot * slotSize * SEC_VH * window.innerHeight, behavior: 'smooth' });
                };
                strip.addEventListener('click', jumpOrOpen);

                const playBtn = strip.querySelector('.strip-play-btn');
                if (playBtn) {
                    playBtn.addEventListener('click', e => {
                        e.stopPropagation();
                        openGameEmbed(playBtn.dataset.embed, playBtn.dataset.title);
                    });
                }

                strip._bun = {
                    header:      strip.querySelector('.strip-header'),
                    footer:      strip.querySelector('.strip-overview-row'),
                    content:     strip.querySelector('.strip-content'),
                    shortDesc:   strip.querySelector('.strip-short-desc'),
                    lipSubtitle: strip.querySelector('.strip-lip-subtitle'),
                    notchHeader: strip.querySelector('.strip-notch-header'),
                    notchLip:    strip.querySelector('.strip-notch-lip'),
                };

                // Tabs live on <body> (position:fixed) so they can render above the
                // stage's own box — including onto the nav bar — rather than being
                // clipped by the stage's overflow:hidden.
                const tab = document.createElement('div');
                tab.className = 'strip-tab';
                tab.setAttribute('aria-hidden', 'true'); // the strip's own h2 carries the title
                tab.style.setProperty('--wash-img', washImg);
                tab.addEventListener('click', jumpOrOpen);

                const tabTitle = document.createElement('span');
                tabTitle.className = 'strip-tab-title';
                tabTitle.textContent = title;
                tab.appendChild(tabTitle);

                document.body.appendChild(tab);
                strip._tab = tab;
            });
            staggerTabs();

            // Expand hint overlay — dismissed on first scroll or header click
            const hint = document.createElement('div');
            hint.id = 'expandHint';
            hint.innerHTML = `
                <svg class="hint-mouse" viewBox="0 0 26 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="1" y="1" width="24" height="42" rx="12" stroke="currentColor" stroke-width="2"/>
                    <rect class="hint-wheel" x="11" y="7" width="4" height="10" rx="2" fill="currentColor"/>
                </svg>
                <span class="hint-text">Scroll or Click<br>to Expand Projects</span>
            `;
            stage.appendChild(hint);

            const dismissHint = () => {
                hint.classList.add('hint-hidden');
            };
            window.addEventListener('scroll', dismissHint, { once: true, passive: true });
            stage.querySelectorAll('.strip-header').forEach(h => {
                h.addEventListener('click', dismissHint, { once: true });
            });
        }

        // Tab stagger follows visible order so filtered lists still zig-zag
        function staggerTabs() {
            visibleStrips().forEach((s, i) => {
                s._tab.style.left = TAB_STAGGER[i % TAB_STAGGER.length] + 'px';
            });
        }

        // ── Discipline filter (?focus=design|programming|production) ──────────
        function applyFilter(discipline) {
            document.querySelectorAll('#sectionsStage .section-strip').forEach(s => {
                const show = discipline === 'all' || s.dataset.disciplines.split(' ').includes(discipline);
                s.hidden = !show;
                if (s._tab) s._tab.hidden = !show;
            });
            document.querySelectorAll('.project-filter').forEach(b => {
                b.setAttribute('aria-pressed', String(b.dataset.filter === discipline));
            });
            const url = new URL(location.href);
            if (discipline === 'all') url.searchParams.delete('focus');
            else url.searchParams.set('focus', discipline);
            history.replaceState(null, '', url);

            closeMobileProject();
            staggerTabs();
            if (!isMobile) sizeStage();
            window.scrollTo(0, 0);
            window.dispatchEvent(new Event('scroll'));
        }

        function loadStripMedia(strip) {
            strip.querySelectorAll('img[data-src], video[data-src]').forEach(el => {
                el.src = el.dataset.src;
                delete el.dataset.src;
            });
        }

        function initScrollEngine() {
            const stage = document.getElementById('sectionsStage');
            let ticking = false;
            let lastActiveIdx = -1;

            function update() {
                if (isMobile) { ticking = false; return; }

                const strips = visibleStrips();
                const N = strips.length;
                if (!N) { ticking = false; return; }

                const stageH   = window.innerHeight - NAV_H;
                const heroH    = stageH * HERO_FRAC;
                const otherH   = N > 1 ? (stageH - heroH) / (N - 1) : 0;
                const bufPx    = BUF_VH * window.innerHeight;
                const secPx    = SEC_VH * window.innerHeight;
                const slotSize = 1 + HERO_HOLD;
                const scrollY  = window.scrollY;

                const heights = new Array(N).fill(otherH);
                let activeIdx = -1;

                if (scrollY <= bufPx) {
                    const t      = bufPx > 0 ? scrollY / bufPx : 1;
                    const equalH = stageH / N;
                    const h0     = equalH + (heroH - equalH) * t;
                    const hRest  = N > 1 ? (stageH - h0) / (N - 1) : 0;
                    heights[0]   = h0;
                    for (let i = 1; i < N; i++) heights[i] = hRest;
                    activeIdx = h0 >= heroH ? 0 : -1;
                } else {
                    const frac     = (scrollY - bufPx) / secPx;
                    const slotIdx  = Math.floor(frac / slotSize);
                    const slotFrac = frac - slotIdx * slotSize;
                    const lo       = Math.min(slotIdx, N - 1);

                    if (lo >= N - 1) {
                        heights[N - 1] = heroH;
                        for (let i = 0; i < N - 1; i++) heights[i] = otherH;
                        activeIdx = N - 1;
                    } else if (slotFrac <= HERO_HOLD) {
                        heights[lo] = heroH;
                        for (let i = 0; i < N; i++) if (i !== lo) heights[i] = otherH;
                        activeIdx = lo;
                    } else {
                        const t  = slotFrac - HERO_HOLD;
                        const hi = lo + 1;
                        heights[lo] = heroH * (1 - t) + otherH * t;
                        heights[hi] = otherH * (1 - t) + heroH * t;
                        for (let i = 0; i < N; i++) {
                            if (i !== lo && i !== hi) heights[i] = otherH;
                        }
                        activeIdx = t < 0.5 ? lo : hi;
                    }
                }

                const stageTop = stage.getBoundingClientRect().top;
                let cumTop = 0;
                // Whatever height the CLOSED strips share this frame (equalH in
                // the overview, hRest mid-buffer, otherH once the accordion is
                // running — the hero/transitioning strip is always >= this).
                // Tall viewports inflate that shared height past BUN_MAX*2 —
                // without this, the excess would spill into the content patty
                // and pull the header/footer buns apart on a strip that's just
                // sitting closed in the list.
                const restBaseline = Math.min(...heights);
                const footerCap = Math.max(BUN_MAX, restBaseline);

                strips.forEach((s, i) => {
                    const h = Math.max(0, heights[i]);

                    const tab = s._tab;
                    if (tab) {
                        // Fixed-positioned relative to the viewport (not clamped to
                        // >=0) so the very top tab can overflow onto the nav bar
                        // when the math puts it there, instead of being clipped.
                        tab.style.top = (stageTop + cumTop - TAB_H) + 'px';
                        tab.classList.toggle('tab-active', i === activeIdx);
                    }
                    cumTop += h;

                    s.style.height = h + 'px';
                    s.classList.toggle('strip-active', i === activeIdx);

                    // Hamburger-bun split: the header bun claims up to BUN_MAX px
                    // and never more. The footer bun is the one that grows to
                    // cover the rest of the resting-state height (up to
                    // footerCap, which tracks otherH so a tall viewport's roomy
                    // at-rest row is always fully absorbed by the two buns) —
                    // only genuine growth beyond that (the hero/expanding strip)
                    // pushes past footerCap and reaches the content "patty".
                    const bun = s._bun;
                    if (bun) {
                        const headerH = Math.max(0, Math.min(BUN_MAX, h / 2));
                        const footerH = Math.max(0, Math.min(footerCap, h - headerH));
                        const contentH = Math.max(0, h - headerH - footerH);
                        bun.header.style.flex     = `0 0 ${headerH}px`;
                        bun.footer.style.flex     = `0 0 ${footerH}px`;
                        bun.footer.style.maxHeight = footerCap + 'px'; // overrides the CSS 48px cap
                        bun.content.style.flex    = `0 0 ${contentH}px`;

                        // Gate for notch-lip's distinct "cutout" treatment
                        // (.strip-open, checked in CSS): below ~1px of real
                        // content, notch-header and notch-lip fully coincide
                        // — the tab is plugged straight into the socket, so
                        // the lip must render identical to the header, not
                        // its own competing translucent layer on top of it.
                        // Threshold is BUN_MAX/2, not ~0: strips near the
                        // scrolled area can pick up a few px of contentH just
                        // from idle-slack redistribution / float rounding
                        // while still visually at rest (header/footer bun
                        // growth absorbs slack well before real content
                        // does, see the comment above headerH/footerH) — a
                        // low threshold flipped .strip-open on for those,
                        // landing the lip's own border a couple px from the
                        // header's and reading as a stray duplicate line.
                        s.classList.toggle('strip-open', contentH >= BUN_MAX / 2);

                        // Both notches use the same shape and always dip
                        // downward from their own seam (never mirrored) —
                        // when contentH is 0 the two seams land on the same
                        // y and the notches sit exactly on top of each other.
                        if (bun.notchHeader) bun.notchHeader.style.top = headerH + 'px';
                        if (bun.notchLip)    bun.notchLip.style.top    = (headerH + contentH) + 'px';

                        // Squished strips (many of them, all at once, while a
                        // neighbor is open) don't have room to show the subtitle
                        // without looking cluttered — fade it out as the footer
                        // bun (which holds the subtitle) shrinks and back in once
                        // there's room again, in sync with the same scroll-driven
                        // value that sizes the bun.
                        if (bun.shortDesc)   bun.shortDesc.style.opacity   = subtitleFadeOpacity(footerH);
                        if (bun.lipSubtitle) bun.lipSubtitle.style.opacity = subtitleFadeOpacity(headerH);
                    }
                });

                // Lazy-load media when a new strip comes into focus
                if (activeIdx !== lastActiveIdx) {
                    if (activeIdx >= 0) {
                        loadStripMedia(strips[activeIdx]);
                        // Prefetch neighbors so they're ready when scrolled to
                        if (strips[activeIdx - 1]) loadStripMedia(strips[activeIdx - 1]);
                        if (strips[activeIdx + 1]) loadStripMedia(strips[activeIdx + 1]);
                    }
                    lastActiveIdx = activeIdx;
                }

                ticking = false;
            }

            window.addEventListener('scroll', () => {
                if (!ticking) { requestAnimationFrame(update); ticking = true; }
            }, { passive: true });

            window.addEventListener('resize', () => {
                checkMobile();
                if (!isMobile) {
                    sizeStage();
                    requestAnimationFrame(update);
                }
            });

            update();
        }

        // ═══════════════════════════════════════════════════════════════════════
        // MOBILE: tap-to-open list/detail view (no scroll engine on mobile)

        function openMobileProject(strip) {
            if (!strip) return;
            document.querySelectorAll('.section-strip').forEach(s => s.classList.toggle('mobile-open', s === strip));
            document.body.classList.add('mobile-project-open');
            loadStripMedia(strip); // lazy-load this project's media only when opened
            window.scrollTo(0, 0);
        }

        function closeMobileProject() {
            document.querySelectorAll('.section-strip.mobile-open').forEach(s => s.classList.remove('mobile-open'));
            document.body.classList.remove('mobile-project-open');
        }

        document.getElementById('mobileBackBar')?.addEventListener('click', closeMobileProject);

        document.addEventListener('DOMContentLoaded', () => {
            checkMobile();
            initStrips();
            initScrollEngine();

            document.querySelectorAll('.project-filter').forEach(b =>
                b.addEventListener('click', () => applyFilter(b.dataset.filter)));
            const focus = new URLSearchParams(location.search).get('focus');
            if (focus && document.querySelector(`.project-filter[data-filter="${focus}"]`)) applyFilter(focus);
        });

        // ═══════════════════════════════════════════════════════════════════════
        // GAME EMBED OVERLAY

        /* ── LIGHTBOX ── */
        let lbMedia = [], lbIdx = 0, lbProjectTitle = '';

        function lbShow(idx) {
            lbIdx = (idx + lbMedia.length) % lbMedia.length;
            const src = lbMedia[lbIdx];
            const body = document.getElementById('lbBody');
            // Remove old media (keep nav buttons)
            body.querySelectorAll('.lightbox-media, .lightbox-media-video').forEach(el => el.remove());
            if (isVideo(src)) {
                const v = document.createElement('video');
                v.src = src; v.controls = true; v.autoplay = true;
                v.muted = false; v.className = 'lightbox-media-video';
                body.insertBefore(v, body.querySelector('.lightbox-nav-next'));
            } else {
                const img = document.createElement('img');
                img.src = src; img.className = 'lightbox-media'; img.alt = '';
                body.insertBefore(img, body.querySelector('.lightbox-nav-next'));
            }
            document.getElementById('lbCounter').textContent =
                lbMedia.length > 1 ? `${lbIdx + 1} / ${lbMedia.length}` : '';
            // Hide nav arrows if only one item
            document.getElementById('lbPrev').style.display = lbMedia.length > 1 ? '' : 'none';
            document.getElementById('lbNext').style.display = lbMedia.length > 1 ? '' : 'none';
        }

        function openLightbox(media, startIdx, projectTitle) {
            lbMedia = media; lbProjectTitle = projectTitle || '';
            document.getElementById('lbTitle').textContent = lbProjectTitle;
            document.getElementById('lightbox').style.display = 'flex';
            lbShow(startIdx);
        }

        function closeLightbox() {
            // Pause any playing video
            document.getElementById('lbBody').querySelectorAll('video').forEach(v => v.pause());
            document.getElementById('lightbox').style.display = 'none';
        }

        document.getElementById('lbClose').addEventListener('click', closeLightbox);
        document.getElementById('lbPrev').addEventListener('click', () => lbShow(lbIdx - 1));
        document.getElementById('lbNext').addEventListener('click', () => lbShow(lbIdx + 1));
        document.getElementById('lightbox').addEventListener('click', e => {
            if (e.target === document.getElementById('lightbox')) closeLightbox();
        });
        document.addEventListener('keydown', e => {
            if (document.getElementById('lightbox').style.display === 'none') return;
            if (e.key === 'Escape')      closeLightbox();
            if (e.key === 'ArrowLeft')   lbShow(lbIdx - 1);
            if (e.key === 'ArrowRight')  lbShow(lbIdx + 1);
        });

        function openGameEmbed(url, title, nativeW = 960, nativeH = 600) {
            const overlay = document.getElementById('playOverlay');
            const iframe  = document.getElementById('playIframe');
            document.getElementById('playOverlayTitle').textContent = title || '';
            iframe.style.transform = '';   // reset any previous scale
            overlay.style.display = 'flex';

            requestAnimationFrame(() => {
                const wrap = overlay.querySelector('.play-iframe-wrap');
                const { width: cw, height: ch } = wrap.getBoundingClientRect();

                let finalUrl = url;
                if (url.includes('embed-upload')) {
                    // Force black background so itch.io padding blends with our overlay
                    finalUrl = finalUrl.replace(/[?&]color=[^&]*/i, '');
                    const sep = finalUrl.includes('?') ? '&' : '?';
                    finalUrl += `${sep}color=000000`;

                    // Scale so the canvas fits inside the container (letterbox if needed).
                    // scaleY is based on nativeH only — the itch.io footer hangs below
                    // the container border (overflow:visible) and stays fully clickable.
                    const scaleX = cw / nativeW;
                    const scaleY = ch / nativeH;
                    const scale  = Math.min(scaleX, scaleY);
                    const ox = (cw - nativeW  * scale) / 2;
                    const oy = (ch - nativeH  * scale) / 2;
                    iframe.style.transform = `translate(${ox}px,${oy}px) scale(${scale})`;
                    iframe.style.width  = nativeW + 'px';
                    iframe.style.height = (nativeH + 42) + 'px';
                }

                iframe.src = finalUrl;
            });
        }

        function closeGameEmbed() {
            const iframe = document.getElementById('playIframe');
            iframe.src = '';   // stops the game / audio
            iframe.style.transform = '';
            iframe.style.width  = '';
            iframe.style.height = '';
            document.getElementById('playOverlay').style.display = 'none';
        }

        document.getElementById('playCloseBtn').addEventListener('click', closeGameEmbed);
        document.getElementById('playFsBtn').addEventListener('click', () => {
            const iframe = document.getElementById('playIframe');
            (iframe.requestFullscreen?.() ?? iframe.webkitRequestFullscreen?.());
        });
        document.getElementById('playOverlay').addEventListener('click', e => {
            if (e.target === document.getElementById('playOverlay')) closeGameEmbed();
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && document.getElementById('playOverlay').style.display !== 'none') {
                closeGameEmbed();
            }
        });

    </script>
</Layout>
