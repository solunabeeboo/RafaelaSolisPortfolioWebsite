---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import siteData from '../data/site.json';
import { getProjects, featuredFor, isVideo } from '../lib/content';
import { personJsonLd } from '../lib/person';

const projects = await getProjects();
const featured = featuredFor(projects);
const homeData = (siteData as any).home;

// Static images only — exclude video and GIF formats (GIFs can be tens of MB each)
const allImages: string[] = projects
    .flatMap(p => p.data.media)
    .filter(s => !isVideo(s) && !s.endsWith('.gif'));

// First image is set inline so the browser can discover and preload it without JS
const heroImage = allImages[0] ?? '';

const PANEL_COUNT = 11;
---
<Layout
    title="Rafaela Solís | Game Designer"
    description="Rafaela Solís is a game designer who builds the systems behind her designs and leads the teams that ship them. Unreal Engine 5, Unity 6, C++, Lua, C#."
    jsonLd={personJsonLd}
>
    {heroImage && <link slot="head" rel="preload" as="image" href={heroImage} fetchpriority="high">}
    <style>
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: calc(var(--nav-h) + 3rem) var(--section-padding) 3rem;
            position: relative;
            overflow: hidden;
            background: var(--border); /* fills corner gaps between strips */
        }

        /* ── PANEL STRIPS ── */
        .panel-bg {
            position: absolute;
            top: 0;
            bottom: 0;
            left: -8%;
            right: -8%;
        }

        .panel-strip {
            position: absolute;
            top: -25%;
            bottom: -25%;
            overflow: hidden;
            transform: skewX(-8deg);
            transform-origin: center center;
            border-right: 3px solid var(--border);
        }

        .panel-strip:last-child { border-right: none; }

        .panel-img {
            position: absolute;
            top: -20%;
            bottom: -20%;
            left: -20vw;
            right: -20vw;
            background-size: cover;
            background-position: center;
            transform: skewX(8deg);       /* counter-skew so image stays upright */
            transform-origin: center center;
            filter: brightness(0.55);
        }

        /* ── HERO BOX ── */
        .hero-content {
            position: relative;
            z-index: 1;
            text-align: center;
            animation: fadeInUp 0.7s ease-out both;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .hero-box {
            background: var(--bg);
            border: 3px solid var(--border);
            box-shadow: 10px 10px 0 var(--border);
            padding: 3rem 4.5rem;
            display: inline-block;
        }

        .hero-name {
            font-size: clamp(3rem, 6vw, 6.5rem);
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1;
            color: var(--text-primary);
            white-space: nowrap;
        }

        .accent-rule {
            width: 80px;
            height: 4px;
            background: var(--accent);
            margin: 1.75rem auto;
        }

        .hero-role {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.22em;
            margin-bottom: 1.25rem;
        }

        .hero-tagline {
            font-size: 1.05rem;
            color: var(--text-muted);
            max-width: 500px;
            margin: 0 auto 3rem;
            line-height: 1.8;
        }

        .cta-group {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            padding: 0.85rem 2.25rem;
            background: var(--accent);
            color: var(--bg);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border: 2px solid var(--border);
            box-shadow: 4px 4px 0 var(--border);
            transition: transform 0.15s, box-shadow 0.15s;
        }

        .cta-button:hover {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0 var(--border);
        }

        .cta-button.secondary {
            background: transparent;
            color: var(--accent);
            border-color: var(--accent);
            box-shadow: 4px 4px 0 var(--accent);
        }

        .cta-button.secondary:hover { box-shadow: 6px 6px 0 var(--accent); }

        @media (max-width: 768px) {
            .hero-name { font-size: clamp(2rem, 10vw, 3.5rem); white-space: normal; }
            .hero-box { padding: 2rem 1.75rem; }

            /*
             * Diagonal stripes: rotate the whole panel container 45° so its
             * vertical strips become diagonal bands going top-left → bottom-right.
             * inset: -100% extends it 3× the hero size so rotated corners still cover.
             */
            .panel-bg {
                top: -100%; bottom: -100%;
                left: -100%; right: -100%;
                transform: rotate(45deg);
            }

            /* 6 evenly-spaced strips, straight (undo desktop skew).
               JS sets left/width inline so !important is needed to override. */
            .panel-strip {
                top: 0; bottom: 0;
                transform: none;
                border-right: 3px solid var(--border);
            }
            .panel-strip:nth-child(1) { left: 0%                   !important; width: calc(100% / 6) !important; }
            .panel-strip:nth-child(2) { left: calc(1 * 100% / 6)   !important; width: calc(100% / 6) !important; }
            .panel-strip:nth-child(3) { left: calc(2 * 100% / 6)   !important; width: calc(100% / 6) !important; }
            .panel-strip:nth-child(4) { left: calc(3 * 100% / 6)   !important; width: calc(100% / 6) !important; }
            .panel-strip:nth-child(5) { left: calc(4 * 100% / 6)   !important; width: calc(100% / 6) !important; }
            .panel-strip:nth-child(6) { left: calc(5 * 100% / 6)   !important; width: calc(100% / 6) !important; border-right: none; }
            .panel-strip:nth-child(n+7) { display: none; }

            /* Counter-rotate images -45° so they appear upright inside the diagonal strips.
               scale(1.5) is the minimum to fill after rotation (1/cos45° ≈ 1.41) + small buffer. */
            .panel-img {
                transform: rotate(-45deg) scale(1.5);
                top: 0; bottom: 0;
                left: -15%; right: -15%;
            }

            .cta-group { flex-direction: column; align-items: center; }
            .cta-button { width: 100%; max-width: 300px; justify-content: center; box-shadow: 2px 2px 0 var(--border); }
            .cta-button.secondary { box-shadow: 2px 2px 0 var(--accent); }
        }

        /* ── BELOW THE HERO ── */
        .home-section { max-width: var(--max-content-width); margin: 0 auto; padding: 4rem var(--section-padding); width: 100%; }
        .open-to {
            margin-top: 1.5rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.12em; color: var(--text-muted);
        }
        .proof {
            list-style: none; display: grid; grid-template-columns: repeat(4, 1fr);
            border: 2px solid var(--border); box-shadow: 4px 4px 0 var(--border); background: var(--card-bg);
        }
        .proof li { padding: 1.25rem 1.35rem; border-right: 2px solid var(--border); display: flex; flex-direction: column; gap: 0.2rem; }
        .proof li:last-child { border-right: none; }
        .proof strong { font-size: 1.6rem; line-height: 1.1; color: var(--accent); letter-spacing: -0.01em; }
        .proof span { font-size: 0.85rem; color: var(--text-secondary); }
        .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
        .section-head h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); text-transform: uppercase; letter-spacing: -0.01em; }
        .section-head a { color: var(--accent); font-weight: 700; text-decoration: none; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.08em; }
        .section-head a:hover { text-decoration: underline; }
        .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
        @media (max-width: 900px) {
            .proof { grid-template-columns: 1fr 1fr; }
            .proof li:nth-child(2) { border-right: none; }
            .proof li:nth-child(-n+2) { border-bottom: 2px solid var(--border); }
        }
        @media (max-width: 480px) {
            .proof { grid-template-columns: 1fr; }
            .proof li { border-right: none; border-bottom: 2px solid var(--border); }
            .proof li:last-child { border-bottom: none; }
        }
    </style>

    <section class="hero">
        <div class="panel-bg">
            {Array.from({ length: PANEL_COUNT }, (_, i) => (
                <div
                    class="panel-strip"
                    style={`left: calc(${i} / ${PANEL_COUNT} * 100%); width: calc(100% / ${PANEL_COUNT} + 1px);`}
                >
                    <div
                        class="panel-img"
                        style={i === 0 && heroImage ? `background-image: url('${heroImage}')` : ''}
                    ></div>
                </div>
            ))}
        </div>

        <div class="hero-content">
            <div class="hero-box">
                <h1 class="hero-name">Rafaela Solís</h1>
                <div class="accent-rule"></div>
                <p class="hero-role">{homeData.role}</p>
                <p class="hero-tagline">{homeData.tagline}</p>
                <div class="cta-group">
                    <a href="/projects/" class="cta-button">View Projects</a>
                    <a href="/resume/" class="cta-button secondary">Resume</a>
                    <a href="/contact/" class="cta-button secondary">Contact</a>
                </div>
                <p class="open-to">{homeData.openTo}</p>
            </div>
        </div>
    </section>

    <section class="home-section" aria-label="Highlights">
        <ul class="proof">
            {homeData.proof.map((p: { stat: string; label: string }) => (
                <li><strong>{p.stat}</strong><span>{p.label}</span></li>
            ))}
        </ul>
    </section>

    <section class="home-section" aria-labelledby="featured-heading" style="padding-top: 0">
        <div class="section-head">
            <h2 id="featured-heading">Featured work</h2>
            <a href="/projects/">All projects &rarr;</a>
        </div>
        <div class="featured-grid">
            {featured.map(p => <ProjectCard project={p} />)}
        </div>
    </section>

    <script define:vars={{ allImages }}>
        // Sample a 4×4 thumbnail of each image to get its average hue
        function getHue(src) {
            return new Promise(resolve => {
                const img = new Image();
                img.onload = () => {
                    const c = document.createElement('canvas');
                    c.width = c.height = 4;
                    const ctx = c.getContext('2d');
                    ctx.drawImage(img, 0, 0, 4, 4);
                    const d = ctx.getImageData(0, 0, 4, 4).data;
                    let r = 0, g = 0, b = 0;
                    for (let i = 0; i < d.length; i += 4) { r += d[i]; g += d[i+1]; b += d[i+2]; }
                    const n = d.length / 4;
                    r /= n; g /= n; b /= n;
                    const max = Math.max(r, g, b), min = Math.min(r, g, b), delta = max - min;
                    let h = 0;
                    if (delta) {
                        if (max === r)      h = ((g - b) / delta + 6) % 6;
                        else if (max === g) h = (b - r) / delta + 2;
                        else                h = (r - g) / delta + 4;
                        h *= 60;
                    }
                    resolve(h);
                };
                img.onerror = () => resolve(0);
                img.src = src;
            });
        }

        const strips = Array.from(document.querySelectorAll('.panel-strip'));
        const needed = strips.length - 1; // strip 0 keeps its inline LCP image

        // Shuffle all images, then pick `needed` evenly-spaced entries so each
        // slot draws from a different part of the collection (no project clusters)
        const shuffled = [...allImages].sort(() => Math.random() - 0.5);
        const step = Math.max(1, Math.floor(shuffled.length / needed));
        const pool = Array.from({ length: needed }, (_, i) => shuffled[(i * step) % shuffled.length]);

        // Sort that diverse selection by hue for the rainbow effect
        Promise.all(pool.map(getHue)).then(hues => {
            const sorted = pool
                .map((src, i) => ({ src, hue: hues[i] }))
                .sort((a, b) => a.hue - b.hue)
                .map(x => x.src);

            strips.forEach((strip, i) => {
                if (i === 0) return;
                const imgEl = strip.querySelector('.panel-img');
                if (imgEl) imgEl.style.backgroundImage = `url('${sorted[i - 1]}')`;
            });
        });
    </script>

</Layout>
