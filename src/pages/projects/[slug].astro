---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getProjects, projectMedia, logoOf, featuredFor } from '../../lib/content';

export async function getStaticPaths() {
    // Old addresses of renamed projects. Each becomes a redirect page once the old
    // project is gone and the new one exists, so links people already shared keep working.
    // (Astro runs this function on its own, so the list has to live inside it.)
    const RENAMED: Record<string, string> = {
        'scrum-facilitation': 'agile-production-tools',
    };
    const projects = await getProjects();
    const ids = new Set(projects.map(p => p.id));
    const moved = Object.entries(RENAMED)
        .filter(([from, to]) => !ids.has(from) && ids.has(to))
        .map(([from, to]) => ({ params: { slug: from }, props: { movedTo: `/projects/${to}/` } }));
    return [...projects.map(p => ({ params: { slug: p.id }, props: { entry: p } })), ...moved];
}

const { movedTo } = Astro.props as { movedTo?: string };
if (movedTo) {
    // A static site can't send a 301, so a tiny page forwards right away.
    return new Response(
        `<!doctype html><meta charset="utf-8"><meta name="robots" content="noindex"><link rel="canonical" href="${new URL(movedTo, Astro.site)}"><meta http-equiv="refresh" content="0; url=${movedTo}"><title>Moved</title><a href="${movedTo}">This project moved</a>`,
        { headers: { 'Content-Type': 'text/html; charset=utf-8' } },
    );
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const media = projectMedia(entry);

// Pager walks the featured projects in her order
const featured = featuredFor(await getProjects());
const at = featured.findIndex(p => p.id === entry.id);
const pick = (p?: (typeof featured)[number]) => (p ? { id: p.id, title: p.data.title } : undefined);
const prev = at > 0 ? pick(featured[at - 1]) : undefined;
const next = at >= 0 && at < featured.length - 1 ? pick(featured[at + 1]) : undefined;

const cover = media.find(m => !m.video);
const ogImage = cover?.image
    ? (await getImage({ src: cover.image, width: 1200, format: 'jpeg' })).src
    : undefined;
---
<Layout
    title={`${d.title} | Rafaela Solís, Game Designer`}
    description={`${d.hook}${d.role ? ` Role: ${d.role}.` : ''}`}
    image={ogImage}
>
    <CaseStudy project={entry} media={media} logo={await logoOf(entry)} prev={prev} next={next}>
        <Content slot="body" />
    </CaseStudy>
</Layout>
