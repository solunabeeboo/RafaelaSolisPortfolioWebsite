---
/*
 * Resume viewer. Which PDFs appear (and in what order) is controlled by
 * src/data/resumes.json; the files themselves live in public/resume/.
 */
import Layout from '../../layouts/Layout.astro';
import { RESUMES } from '../../lib/content';

const [first] = RESUMES;
---
<Layout
    title="Resume | Rafaela Solís, Game Designer"
    description="Resume of Rafaela Solís, game designer: experience at Pentad Games, education at Champlain College, and skills in C++, Lua, C#, Unreal Engine 5, and Unity 6."
>
    <style>
        .resume-page {
            display: flex;
            flex-direction: column;
            height: calc(100vh - var(--nav-h));
            padding-top: var(--nav-h);
        }

        .resume-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.85rem 2rem;
            border-bottom: 2px solid var(--border);
            background: var(--bg);
            flex-shrink: 0;
        }

        .resume-header-left {
            display: flex;
            flex-direction: column;
        }

        .resume-eyebrow {
            font-size: 0.62rem;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.2em;
        }

        .resume-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
        }

        .resume-tabs { display: flex; gap: 0.35rem; flex-wrap: wrap; }
        .resume-tab {
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 0.35rem 0.8rem; border: 2px solid var(--border); text-decoration: none;
            color: var(--text-primary); background: transparent;
        }
        .resume-tab:hover { background: var(--accent-sage); color: var(--bg); }
        .resume-tab[aria-current="true"] { background: var(--accent); color: var(--bg); }

        .resume-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 1.25rem;
            font-weight: 700;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            text-decoration: none;
            border: 2px solid var(--border);
            box-shadow: 3px 3px 0 var(--border);
            transition: transform 0.15s, box-shadow 0.15s;
            cursor: pointer;
        }

        .action-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0 var(--border);
        }

        .action-btn.primary {
            background: var(--accent);
            color: var(--bg);
        }

        .action-btn.outline {
            background: transparent;
            color: var(--accent);
            border-color: var(--accent);
            box-shadow: 3px 3px 0 var(--accent);
        }

        .action-btn.outline:hover { box-shadow: 5px 5px 0 var(--accent); }

        /* Page(s) drawn with PDF.js: no browser toolbar, sidebar, or zoom —
           just the resume, fit to the screen like a sheet of paper. */
        .resume-viewer {
            flex: 1;
            overflow: auto;
            background: rgba(26, 26, 26, 0.07);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            padding: 1.5rem;
        }

        .resume-viewer :global(.resume-sheet) {
            position: relative;
            flex-shrink: 0;
            background: #fff;
            border: 2px solid var(--border);
            box-shadow: 6px 6px 0 var(--border);
        }

        .resume-viewer :global(.resume-sheet canvas) { display: block; }
        .resume-viewer :global(.resume-sheet) { cursor: zoom-in; }
        .resume-viewer.zoomed :global(.resume-sheet) { cursor: zoom-out; }

        /* Invisible hit areas over the PDF's own links (email, site, LinkedIn) */
        .resume-viewer :global(.resume-sheet a) { position: absolute; }

        .resume-fallback { color: var(--text-secondary); margin: auto; text-align: center; }
        .resume-fallback a { color: var(--accent); font-weight: 700; }

        @media (max-width: 768px) {
            .resume-page { height: auto; min-height: calc(100svh - var(--nav-h)); padding-top: 0; }
            .resume-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; padding: 5rem 1.25rem 1rem; }
            .resume-actions { flex-wrap: wrap; }
            /* Let the page grow instead of scrolling inside a box */
            .resume-viewer { overflow: visible; padding: 1rem; }
            .resume-viewer :global(.resume-sheet) { box-shadow: 4px 4px 0 var(--border); cursor: auto; }
        }
    </style>

    <main class="resume-page">
        <div class="resume-header">
            <div class="resume-header-left">
                <span class="resume-eyebrow">Rafaela Solís</span>
                <h1 class="resume-title">Resume</h1>
            </div>
            {RESUMES.length > 1 && (
                <nav class="resume-tabs" aria-label="Resume versions">
                    {RESUMES.map((r, i) => (
                        <a class="resume-tab" href={r.file} data-file={r.file} aria-current={String(i === 0)}>{r.label}</a>
                    ))}
                </nav>
            )}
            <div class="resume-actions">
                <a href={first.file} class="action-btn outline" data-resume-open target="_blank" rel="noopener">Open in New Tab ↗</a>
                <a href={first.file} class="action-btn primary" data-resume-download download>Download PDF</a>
            </div>
        </div>

        <div class="resume-viewer" id="resumeViewer" data-file={first.file} aria-label="Resume preview">
            <p class="resume-fallback">
                <a href={first.file} data-resume-open>Open the resume (PDF)</a>
            </p>
        </div>
    </main>

    <script>
        import * as pdfjs from 'pdfjs-dist';
        import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

        pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

        const viewer = document.getElementById('resumeViewer')!;
        const mobile = window.matchMedia('(max-width: 768px)');
        let doc: pdfjs.PDFDocumentProxy | null = null;
        let renderToken = 0;

        // Desktop: the whole page fits on screen (it's a one-pager); click
        // the page to zoom in for reading, click again to fit. Mobile: fill
        // the width and let the page scroll.
        let zoomed = false;
        function scaleFor(pageW: number, pageH: number) {
            const pad = mobile.matches ? 32 : 48;
            const fitWidth = (viewer.clientWidth - pad) / pageW;
            if (mobile.matches) return fitWidth;
            if (zoomed) return Math.min(fitWidth, 960 / pageW);
            return Math.min(fitWidth, (viewer.clientHeight - pad) / pageH);
        }

        viewer.addEventListener('click', e => {
            if (mobile.matches || !(e.target as Element).closest('.resume-sheet') || (e.target as Element).closest('a')) return;
            zoomed = !zoomed;
            viewer.classList.toggle('zoomed', zoomed);
            render();
        });

        async function render() {
            if (!doc) return;
            const token = ++renderToken;
            const first = await doc.getPage(1);
            const base = first.getViewport({ scale: 1 });
            const scale = scaleFor(base.width, base.height);
            const dpr = window.devicePixelRatio || 1;

            const sheets: HTMLElement[] = [];
            for (let n = 1; n <= doc.numPages; n++) {
                const page = n === 1 ? first : await doc.getPage(n);
                const vp = page.getViewport({ scale });

                const sheet = document.createElement('div');
                sheet.className = 'resume-sheet';
                sheet.style.width = vp.width + 'px';
                sheet.style.height = vp.height + 'px';

                const canvas = document.createElement('canvas');
                canvas.width = Math.floor(vp.width * dpr);
                canvas.height = Math.floor(vp.height * dpr);
                canvas.style.width = vp.width + 'px';
                canvas.style.height = vp.height + 'px';
                sheet.appendChild(canvas);

                await page.render({
                    canvasContext: canvas.getContext('2d')!,
                    viewport: vp,
                    transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : undefined,
                }).promise;

                for (const a of await page.getAnnotations()) {
                    if (a.subtype !== 'Link' || !a.url) continue;
                    const [x1, y1, x2, y2] = vp.convertToViewportRectangle(a.rect);
                    const link = document.createElement('a');
                    link.href = a.url;
                    link.target = '_blank';
                    link.rel = 'noopener';
                    link.setAttribute('aria-label', a.url);
                    Object.assign(link.style, {
                        left: Math.min(x1, x2) + 'px', top: Math.min(y1, y2) + 'px',
                        width: Math.abs(x2 - x1) + 'px', height: Math.abs(y2 - y1) + 'px',
                    });
                    sheet.appendChild(link);
                }
                sheets.push(sheet);
            }
            // A newer render (resize / tab switch) started meanwhile: drop this one
            if (token === renderToken) viewer.replaceChildren(...sheets);
        }

        async function load(file: string) {
            try {
                doc = await pdfjs.getDocument(file).promise;
                await render();
            } catch {
                // Leave the plain "Open the resume" link in place
            }
        }

        let resizeTimer: number | undefined;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(render, 150);
        });

        // Version tabs: swap the preview and the open/download links in place
        document.querySelectorAll<HTMLAnchorElement>('.resume-tab').forEach(tab => {
            tab.addEventListener('click', e => {
                e.preventDefault();
                const file = tab.dataset.file!;
                document.querySelectorAll<HTMLAnchorElement>('[data-resume-open], [data-resume-download]')
                    .forEach(a => { a.href = file; });
                document.querySelectorAll('.resume-tab')
                    .forEach(t => t.setAttribute('aria-current', String(t === tab)));
                load(file);
            });
        });

        load(viewer.dataset.file!);
    </script>
</Layout>
