---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import headshot from '../../assets/site/headshot.webp';
import { getExperience, getAwards, getSkills, getCourses } from '../../lib/content';
import { site } from '../../lib/view';
import { personJsonLd } from '../../lib/person';

const about = site.about;
const [experience, awards, skills, courses] = await Promise.all([getExperience(), getAwards(), getSkills(), getCourses()]);
const edu = about.education;
---
<Layout
    title="About | Rafaela Solís, Game Designer"
    description="About Rafaela Solís: game designer studying Game Design and Game Programming at Champlain College, with skills in C++, Lua, C#, Unreal Engine 5, and Unity 6."
    jsonLd={personJsonLd}
>
    <div class="wrap about">
        <h1>About</h1>

        <div class="layout">
            <div class="text">
                <section class="bio prose" aria-label="Bio">
                    {about.bio.map((para: string) => <p>{para}</p>)}
                    {about.lookingFor && <p>{about.lookingFor}</p>}
                </section>

                {experience.length > 0 && (
                    <section>
                        <h2>Experience</h2>
                        <ol class="entries">
                            {experience.map(e => (
                                <li>
                                    <p class="when">{e.data.start} to {e.data.end}</p>
                                    <div>
                                        <h3>{e.data.title}</h3>
                                        <p class="org">{e.data.org}{e.data.location && `, ${e.data.location}`}</p>
                                        {e.data.bullets.length > 0 && (
                                            <ul class="bullets">
                                                {e.data.bullets.map((b: string) => <li>{b}</li>)}
                                            </ul>
                                        )}
                                    </div>
                                </li>
                            ))}
                        </ol>
                    </section>
                )}

                {edu && (
                    <section>
                        <h2>Education</h2>
                        <ol class="entries">
                            <li>
                                <p class="when">{edu.dates}</p>
                                <div>
                                    <h3>{edu.school}</h3>
                                    <p class="org">{edu.degrees}</p>
                                    {edu.honors && <p class="org">{edu.honors}</p>}
                                </div>
                            </li>
                        </ol>
                    </section>
                )}

                {awards.length > 0 && (
                    <section>
                        <h2>Awards</h2>
                        <ul class="plain">
                            {awards.map(a => (
                                <li>
                                    {a.data.url ? <a href={a.data.url}>{a.data.title}</a> : a.data.title}
                                    {(a.data.issuer || a.data.date) && <span class="org">, {[a.data.issuer, a.data.date].filter(Boolean).join(', ')}</span>}
                                </li>
                            ))}
                        </ul>
                    </section>
                )}

                {skills.length > 0 && (
                    <section>
                        <h2>Skills</h2>
                        <dl class="facts skills">
                            {skills.map(s => <><dt>{s.data.name}</dt><dd>{s.data.items.join(', ')}</dd></>)}
                        </dl>
                    </section>
                )}

                {courses.length > 0 && (
                    <section>
                        <details>
                            <summary>Coursework</summary>
                            <p>{courses.map(c => c.data.name).join(', ')}</p>
                        </details>
                    </section>
                )}
            </div>

            <aside class="side" aria-label="At a glance">
                <Picture
                    src={headshot}
                    alt={about.name}
                    formats={['avif', 'webp']}
                    widths={[280, 560]}
                    sizes="(min-width: 861px) 280px, 200px"
                    loading="eager"
                    fetchpriority="high"
                    class="photo"
                />
                <dl class="facts card">
                    {about.stats.map((s: { label: string; value: string }) => <><dt>{s.label}</dt><dd>{s.value}</dd></>)}
                </dl>
            </aside>
        </div>
    </div>
</Layout>

<style>
    .about { padding-top: var(--space-6); }
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--space-8); margin-top: var(--space-5); align-items: start; }
    .text > section + section { margin-top: var(--space-8); }
    .text h2 { margin-bottom: var(--space-4); }
    .bio { max-width: 68ch; }
    .bio > * + * { margin-top: var(--space-4); }

    .entries { display: grid; gap: var(--space-6); }
    .entries > li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-5); }
    .when { color: var(--ink-3); font-size: var(--step--1); line-height: 1.9; font-variant-numeric: tabular-nums; }
    .entries h3 { font-size: var(--step-0); line-height: 1.35; }
    .org { color: var(--ink-2); }
    .bullets { list-style: disc; padding-left: 1.25em; display: grid; gap: var(--space-2); margin-top: var(--space-3); max-width: 68ch; }
    .plain { display: grid; gap: var(--space-2); }

    .skills { gap: var(--space-3) var(--space-6); max-width: 68ch; }
    .skills dt { color: var(--ink); font-weight: 600; font-size: var(--step-0); line-height: 1.6; }
    .skills dd { color: var(--ink-2); }

    details summary { cursor: pointer; font-weight: 600; font-size: var(--step-1); }
    details p { margin-top: var(--space-3); color: var(--ink-2); max-width: 68ch; }

    .side { position: sticky; top: calc(var(--header-h) + var(--space-5)); display: grid; gap: var(--space-5); }
    .side :global(.photo) { width: 100%; max-width: 300px; aspect-ratio: 1; object-fit: cover; border-radius: 6px; background: var(--board); }
    .card { background: var(--board); border-top: 2px solid var(--forest); padding: var(--space-4) var(--space-5); border-radius: 0 0 6px 6px; grid-template-columns: 1fr; gap: 0; }
    .card dd { margin-bottom: var(--space-3); }
    .card dd:last-child { margin-bottom: 0; }

    @media (max-width: 860px) {
        .layout { grid-template-columns: 1fr; gap: var(--space-6); }
        .side { position: static; order: -1; grid-template-columns: 140px minmax(0, 1fr); align-items: start; }
        .side :global(.photo) { max-width: 140px; }
        .entries > li { grid-template-columns: 1fr; gap: var(--space-1); }
    }
    @media (max-width: 480px) {
        .side { grid-template-columns: 1fr; }
        .side :global(.photo) { max-width: 160px; }
    }
</style>
