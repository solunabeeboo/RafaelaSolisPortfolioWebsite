---
/*
 * Resume viewer. Which PDFs appear (and in what order) is controlled by
 * src/data/resumes.json; the files themselves live in public/resume/.
 */
import Layout from '../../layouts/Layout.astro';
import { RESUMES } from '../../lib/content';

const [first] = RESUMES;
const viewerSrc = (file: string) => `${file}#view=FitH&navpanes=0`;
---
<Layout
    title="Resume | Rafaela Solís, Game Designer"
    description="Resume of Rafaela Solís, game designer: experience at Pentad Games, education at Champlain College, and skills in C++, Lua, C#, Unreal Engine 5, and Unity 6."
>
    <style>
        .resume-page {
            display: flex;
            flex-direction: column;
            height: calc(100vh - var(--nav-h));
            padding-top: var(--nav-h);
        }

        .resume-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.85rem 2rem;
            border-bottom: 2px solid var(--border);
            background: var(--bg);
            flex-shrink: 0;
        }

        .resume-header-left {
            display: flex;
            flex-direction: column;
        }

        .resume-eyebrow {
            font-size: 0.62rem;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.2em;
        }

        .resume-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
        }

        .resume-tabs { display: flex; gap: 0.35rem; flex-wrap: wrap; }
        .resume-tab {
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 0.35rem 0.8rem; border: 2px solid var(--border); text-decoration: none;
            color: var(--text-primary); background: transparent;
        }
        .resume-tab:hover { background: var(--accent-sage); color: var(--bg); }
        .resume-tab[aria-current="true"] { background: var(--accent); color: var(--bg); }

        .resume-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 1.25rem;
            font-weight: 700;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            text-decoration: none;
            border: 2px solid var(--border);
            box-shadow: 3px 3px 0 var(--border);
            transition: transform 0.15s, box-shadow 0.15s;
            cursor: pointer;
        }

        .action-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0 var(--border);
        }

        .action-btn.primary {
            background: var(--accent);
            color: var(--bg);
        }

        .action-btn.outline {
            background: transparent;
            color: var(--accent);
            border-color: var(--accent);
            box-shadow: 3px 3px 0 var(--accent);
        }

        .action-btn.outline:hover { box-shadow: 5px 5px 0 var(--accent); }

        .resume-embed-wrapper {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

        .resume-iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Phones don't render PDFs inside iframes reliably (Android shows a
           blank box, iOS only the first page), so hand off to the device's
           own PDF viewer instead. */
        .resume-mobile { display: none; }

        @media (max-width: 768px) {
            .resume-page { height: auto; min-height: calc(100svh - var(--nav-h)); padding-top: 0; }
            .resume-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; padding: 5rem 1.25rem 1rem; }
            .resume-actions { display: none; } /* the card below has the same buttons */
            .resume-embed-wrapper { display: none; }
            .resume-mobile {
                display: flex; flex-direction: column; gap: 0.85rem; align-items: stretch;
                margin: 1.5rem 1.25rem; padding: 1.5rem;
                border: 2px solid var(--border); box-shadow: 4px 4px 0 var(--border); background: var(--card-bg);
            }
            .resume-mobile p { color: var(--text-secondary); font-size: 0.95rem; }
            .resume-mobile .action-btn { justify-content: center; }
        }
    </style>

    <main class="resume-page">
        <div class="resume-header">
            <div class="resume-header-left">
                <span class="resume-eyebrow">Rafaela Solís</span>
                <h1 class="resume-title">Resume</h1>
            </div>
            {RESUMES.length > 1 && (
                <nav class="resume-tabs" aria-label="Resume versions">
                    {RESUMES.map((r, i) => (
                        <a class="resume-tab" href={r.file} data-file={r.file} aria-current={String(i === 0)}>{r.label}</a>
                    ))}
                </nav>
            )}
            <div class="resume-actions">
                <a href={first.file} class="action-btn outline" data-resume-open target="_blank" rel="noopener">Open in New Tab ↗</a>
                <a href={first.file} class="action-btn primary" data-resume-download download>Download PDF</a>
            </div>
        </div>

        <div class="resume-embed-wrapper">
            <iframe class="resume-iframe" id="resumeFrame" src={viewerSrc(first.file)} title="Rafaela Solís — Resume"></iframe>
        </div>

        <div class="resume-mobile">
            <p>View the resume full screen in your phone's PDF viewer, or save a copy.</p>
            <a href={first.file} class="action-btn primary" data-resume-open target="_blank" rel="noopener">Open Resume ↗</a>
            <a href={first.file} class="action-btn outline" data-resume-download download>Download PDF</a>
        </div>
    </main>

    <script>
        // Version tabs: swap the viewer and the open/download links in place
        const frame = document.getElementById('resumeFrame') as HTMLIFrameElement | null;
        document.querySelectorAll<HTMLAnchorElement>('.resume-tab').forEach(tab => {
            tab.addEventListener('click', e => {
                e.preventDefault();
                const file = tab.dataset.file!;
                if (frame) frame.src = `${file}#view=FitH&navpanes=0`;
                document.querySelectorAll<HTMLAnchorElement>('[data-resume-open], [data-resume-download]')
                    .forEach(a => { a.href = file; });
                document.querySelectorAll('.resume-tab')
                    .forEach(t => t.setAttribute('aria-current', String(t === tab)));
            });
        });
    </script>
</Layout>
