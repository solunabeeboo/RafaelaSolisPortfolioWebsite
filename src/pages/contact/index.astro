---
import Layout from '../../layouts/Layout.astro';
import { RESUMES } from '../../lib/content';
import { site, EMAIL, SOCIAL } from '../../lib/view';
---
<Layout
    title="Contact | Rafaela Solís"
    description="Contact Rafaela Solís, game designer, by email, LinkedIn, GitHub, itch.io, or Bluesky."
>
    <div class="wrap contact">
        <h1>Contact</h1>
        <p class="open">{site.home.openTo}</p>

        <dl class="channels">
            <dt>Email</dt>
            <dd>
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
                <button type="button" class="btn small copy-btn" data-copy={EMAIL}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.25" y="5.25" width="8" height="8.5" rx="1.25"/><path d="M10.75 5.25V3.5a1.25 1.25 0 0 0-1.25-1.25h-5.5A1.25 1.25 0 0 0 2.75 3.5v6.25A1.25 1.25 0 0 0 4 11h1.25"/></svg>
                    <span aria-live="polite">Copy email</span>
                </button>
            </dd>
            {SOCIAL.map(n => (
                <>
                    <dt>{n.label}</dt>
                    <dd><a href={n.href}>{n.handle}</a></dd>
                </>
            ))}
            <dt>Résumé</dt>
            <dd><a href="/resume/">View online</a> <span class="sep">or</span> <a href={RESUMES[0].file} download>download the PDF</a></dd>
        </dl>
    </div>
</Layout>

<style>
    .contact { padding-top: var(--space-6); }
    .open { margin-top: var(--space-3); color: var(--ink-2); }
    .channels {
        display: grid; grid-template-columns: 8rem minmax(0, 1fr); margin-top: var(--space-6); max-width: 44rem;
        border-top: 2px solid var(--outline);
    }
    .channels dt, .channels dd { padding: var(--space-4) 0; border-bottom: 1px solid var(--rule); display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3); }
    .channels dt { color: var(--ink-3); font-size: var(--step--1); }
    .channels dd { font-size: var(--step-1); font-weight: 600; }
    .channels dd a { overflow-wrap: anywhere; }
    .sep { color: var(--ink-3); font-weight: 400; font-size: var(--step-0); }
    @media (max-width: 480px) {
        .channels { grid-template-columns: 1fr; }
        .channels dt { padding-bottom: 0; border-bottom: 0; }
        .channels dd { padding-top: var(--space-1); }
    }
</style>
