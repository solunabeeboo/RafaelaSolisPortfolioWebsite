---
// Work lives on Home now (featured folders plus the rest). Old links to
// /projects/ (with ?focus= or #slug) land there with their query and hash.
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex">
    <link rel="canonical" href={new URL('/', Astro.site).href}>
    <title>Work | Rafaela Solís</title>
    <script is:inline>location.replace('/' + location.search + (location.hash || '#work'));</script>
    <meta http-equiv="refresh" content="0; url=/#work">
</head>
<body>
    <p><a href="/#work">Rafaela Solís: work</a></p>
</body>
</html>
