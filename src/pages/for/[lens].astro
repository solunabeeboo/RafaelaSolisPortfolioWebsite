---
/*
 * Recruiter-specific landing pages: /for/design/, /for/programming/, /for/production/
 * Unlisted (noindex, not in nav or sitemap). Same vault content, reordered
 * for the role, with the matching resume. The public identity stays
 * "Game Designer"; these are links you hand to a specific recruiter.
 */
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import siteData from '../../data/site.json';
import { getProjects, featuredFor, resumeFor, DISCIPLINE_LABELS, type Discipline } from '../../lib/content';
import { DISCIPLINES } from '../../content.config';

export function getStaticPaths() {
    return DISCIPLINES.map(lens => ({ params: { lens } }));
}

const lens = Astro.params.lens as Discipline;
const copy = (siteData as any).lenses[lens];
const projects = await getProjects();
const featured = featuredFor(projects, lens);
// Up to 3 more strong matches that aren't already featured
const resume = resumeFor(lens);
const more = projects.filter(p => !p.data.featured && p.data.disciplines[0] === lens).slice(0, 3);
---
<Layout
    title={`Rafaela Solís | ${copy.title}`}
    description={copy.summary}
    noindex
>
    <style>
        .lens { max-width: var(--max-content-width); margin: 0 auto; padding: calc(var(--nav-h) + 3.5rem) var(--section-padding) 4rem; width: 100%; }
        .intro {
            background: var(--bg); border: 3px solid var(--border); box-shadow: 10px 10px 0 var(--border);
            padding: 2.5rem 3rem; max-width: 52rem;
        }
        .eyebrow { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: var(--text-muted); }
        h1 { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.03em; margin: 0.4rem 0 0.6rem; }
        .role { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--accent); margin-bottom: 1.1rem; }
        .summary { color: var(--text-secondary); line-height: 1.8; }
        .ctas { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem; }
        .cta {
            display: inline-flex; padding: 0.75rem 1.6rem; text-decoration: none; font-weight: 700; font-size: 0.8rem;
            text-transform: uppercase; letter-spacing: 0.06em; border: 2px solid var(--border);
            background: var(--accent); color: var(--bg); box-shadow: 4px 4px 0 var(--border);
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .cta.secondary { background: transparent; color: var(--accent); border-color: var(--accent); box-shadow: 4px 4px 0 var(--accent); }
        .cta:hover { transform: translate(-2px, -2px); }
        h2 { font-size: clamp(1.4rem, 2.6vw, 2rem); text-transform: uppercase; margin: 3.5rem 0 1.25rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
        @media (max-width: 768px) { .intro { padding: 1.75rem 1.5rem; box-shadow: 6px 6px 0 var(--border); } }
    </style>

    <main class="lens">
        <section class="intro">
            <p class="eyebrow">Portfolio</p>
            <h1>Rafaela Solís</h1>
            <p class="role">{copy.title}</p>
            <p class="summary">{copy.summary}</p>
            <div class="ctas">
                <a class="cta" href={resume.file} download>{resume.discipline ? `${resume.label} resume (PDF)` : "Resume (PDF)"}</a>
                <a class="cta secondary" href={`/projects/?focus=${lens}`}>All {DISCIPLINE_LABELS[lens].toLowerCase()} work</a>
                <a class="cta secondary" href="/contact/">Contact</a>
            </div>
        </section>

        <h2>Featured work</h2>
        <div class="grid">{featured.map(p => <ProjectCard project={p} />)}</div>

        {more.length > 0 && (
            <Fragment>
                <h2>More {DISCIPLINE_LABELS[lens].toLowerCase()}</h2>
                <div class="grid">{more.map(p => <ProjectCard project={p} />)}</div>
            </Fragment>
        )}
    </main>
</Layout>
