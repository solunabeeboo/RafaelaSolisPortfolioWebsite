---
// Small pixel-art icons, drawn from 8x8 (or 10x8) grids: '#' is a filled pixel.
// Rendered as one crisp SVG path in currentColor; size it with CSS.
interface Props {
    name: string;
    class?: string;
}

const ICONS: Record<string, string[]> = {
    code: ['........', '..#..#..', '.#....#.', '#......#', '.#....#.', '..#..#..', '........', '........'],
    gear: ['...##...', '.#.##.#.', '..####..', '###..###', '###..###', '..####..', '.#.##.#.', '...##...'],
    pencil: ['......##', '.....###', '....###.', '...###..', '..###...', '.###....', '##......', '#.......'],
    clipboard: ['..####..', '.######.', '.#....#.', '.#.##.#.', '.#....#.', '.#.##.#.', '.#....#.', '.######.'],
    palette: ['..####..', '.#....#.', '#.#..#.#', '#......#', '#.#...##', '#....#..', '.#...#..', '..###...'],
    globe: ['..####..', '.#.##.#.', '#..##..#', '########', '#..##..#', '#..##..#', '.#.##.#.', '..####..'],
    magnifier: ['.####...', '#....#..', '#....#..', '#....#..', '#....#..', '.####...', '.....##.', '......##'],
    briefcase: ['........', '..####..', '..#..#..', '########', '#......#', '########', '#......#', '########'],
    cap: ['........', '...##...', '.######.', '########', '.######.', '..#..#.#', '..####.#', '........'],
    star: ['...##...', '...##...', '########', '.######.', '..####..', '.##..##.', '##....##', '........'],
    book: ['........', '###..###', '#..##..#', '#..##..#', '#..##..#', '#..##..#', '########', '........'],
    pin: ['..####..', '.######.', '.##..##.', '.##..##.', '.######.', '..####..', '...##...', '...##...'],
    mail: ['........', '########', '##....##', '#.#..#.#', '#..##..#', '#......#', '########', '........'],
    gamepad: ['.########.', '##.#####.#', '#...###.##', '##.#######', '##########', '###....###', '##......##', '..........'],
    document: ['.#####..', '.#...##.', '.#....#.', '.#.##.#.', '.#....#.', '.#.##.#.', '.#....#.', '.######.'],
    butterfly: ['........', '##....##', '###..###', '########', '.######.', '###..###', '##....##', '........'],
    heart: ['........', '.##..##.', '########', '########', '.######.', '..####..', '...##...', '........'],
};

const { name, class: className } = Astro.props;
const grid = ICONS[name] ?? ICONS.star;
const w = grid[0].length;
const h = grid.length;
let d = '';
grid.forEach((row, y) => {
    for (let x = 0; x < row.length; x++) if (row[x] === '#') d += `M${x} ${y}h1v1h-1z`;
});
---
<svg class:list={['pixel-icon', className]} viewBox={`0 0 ${w} ${h}`} fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d={d} /></svg>
