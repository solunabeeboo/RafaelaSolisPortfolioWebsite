---
// The case-study body, shared by /projects/<slug>/ and the dev-only vault preview.
// Her markdown goes in the "body" slot; empty sections are not rendered.
import { getImage } from 'astro:assets';
import Media from './Media.astro';
import { getProjects, canLoop, type MediaItem } from '../lib/content';
import { projectFacts, liveLinks, isExternal, type ProjectLike } from '../lib/view';
import { renderMarkdown } from '../lib/markdown';

interface Props {
    project: ProjectLike;
    media: MediaItem[];
    prev?: { id: string; title: string };
    next?: { id: string; title: string };
}

const { project, media, prev, next } = Astro.props;
const d = project.data;

const facts = projectFacts(d);
const publicIds = (await getProjects()).map(p => p.id);
const links = liveLinks(d.links, publicIds);

const cover = media.find(m => !m.video && m.src === d.image) ?? media.find(m => !m.video);
const hero = cover ?? media.find(m => m.video);
const gallery = media.filter(m => m !== hero);

// Full-size file for the lightbox; previews use the vault file as is.
async function fullUrl(m: MediaItem) {
    if (m.image) return (await getImage({ src: m.image, width: Math.min(1800, m.image.width), format: 'webp' })).src;
    return (m as any).rawUrl as string | undefined;
}
const altOf = (m: MediaItem) => m.alt || `${d.title} screenshot`;
const heroFull = hero && !hero.video ? await fullUrl(hero) : undefined;
const galleryItems = await Promise.all(gallery.map(async m => ({ m, full: m.video ? undefined : await fullUrl(m) })));

const [problem, goal, result, reflection] = await Promise.all(
    [d.problem, d.goal, d.result, d.reflection].map(renderMarkdown),
);
const iterations: { before: string; finding: string; change: string }[] = d.iterations ?? [];
const hasBody = Astro.slots.has('body');
const embed = d.embed as { type: 'game' | 'widget'; url: string } | undefined;
const heroRatio = (m: MediaItem) => (m.image ? m.image.width / m.image.height : m.meta ? m.meta.width / m.meta.height : 16 / 9);
---
<article class="cs">
    <div class="wrap">
        <p class="back"><a href="/projects/">&larr; Work</a></p>
        <div class="tabline">
            <div class="cs-tab" style={`view-transition-name: tab-${project.id}`}>
                <h1>{d.title}</h1>
            </div>
        </div>
        <div class="cs-folder">
            <p class="lead">{d.hook}</p>
            <div class="cs-grid">
                {hero && (
                    <div class="hero" style={`--ratio: ${heroRatio(hero).toFixed(4)}`}>
                        {hero.video ? (
                            <video
                                src={hero.url}
                                poster={hero.posterUrl}
                                width={hero.meta?.width}
                                height={hero.meta?.height}
                                controls
                                playsinline
                                preload="none"
                                muted={canLoop(hero.src) || undefined}
                                loop={canLoop(hero.src) || undefined}
                                data-loop={canLoop(hero.src) ? '' : undefined}
                                aria-label={`${d.title} gameplay video`}
                            ></video>
                        ) : (
                            <a href={heroFull} data-lightbox data-alt={altOf(hero)} data-caption={hero.caption} aria-label={`Enlarge: ${altOf(hero)}`}>
                                <Media
                                    item={hero}
                                    alt={altOf(hero)}
                                    sizes="(min-width: 1000px) 760px, calc(100vw - 64px)"
                                    widths={[640, 960, 1280, 1600]}
                                    priority
                                />
                            </a>
                        )}
                    </div>
                )}
                <aside class="card" aria-label="Project facts">
                    {facts.length > 0 || links.length > 0 ? (
                        <dl class="facts">
                            {facts.map(f => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}
                            {links.length > 0 && (
                                <>
                                    <dt>Links</dt>
                                    <dd class="links">
                                        {links.map(l => (
                                            <a href={l.url} {...(isExternal(l.url) ? { rel: 'noopener' } : {})}>
                                                {l.label}{isExternal(l.url) && <span aria-hidden="true"> &#8599;</span>}
                                            </a>
                                        ))}
                                    </dd>
                                </>
                            )}
                        </dl>
                    ) : null}
                </aside>
            </div>
        </div>
    </div>

    <div class="wrap main">
        {d.contribution?.length > 0 && (
            <section>
                <h2>What I did</h2>
                <ul class="bullets">
                    {d.contribution.map((c: string) => <li>{c}</li>)}
                </ul>
            </section>
        )}

        {problem && <section><h2>Problem</h2><div class="prose" set:html={problem} /></section>}
        {goal && <section><h2>Goal</h2><div class="prose" set:html={goal} /></section>}

        {iterations.length > 0 && (
            <section>
                <h2>Iterations</h2>
                <ol class="iterations">
                    {iterations.map(it => (
                        <li>
                            <dl>
                                <dt>Before</dt><dd>{it.before}</dd>
                                <dt>What we found</dt><dd>{it.finding}</dd>
                                <dt>What changed</dt><dd>{it.change}</dd>
                            </dl>
                        </li>
                    ))}
                </ol>
            </section>
        )}

        {result && <section><h2>Result</h2><div class="prose" set:html={result} /></section>}
        {reflection && <section><h2>Reflection</h2><div class="prose" set:html={reflection} /></section>}

        {hasBody && <section class="body"><div class="prose"><slot name="body" /></div></section>}

        {embed && (
            <section>
                <h2>{embed.type === 'game' ? 'Play in the browser' : 'On itch.io'}</h2>
                <div class={`embed ${embed.type}`} data-embed={embed.url} data-title={`${d.title} on itch.io`}>
                    <button type="button" class="btn primary">{embed.type === 'game' ? 'Play in browser' : 'Load the itch.io page'}</button>
                </div>
            </section>
        )}

        {galleryItems.length > 0 && (
            <section>
                <h2>Gallery</h2>
                <ul class="gallery">
                    {galleryItems.map(({ m, full }) => (
                        <li>
                            <figure>
                                {m.video ? (
                                    <video
                                        src={m.url}
                                        poster={m.posterUrl}
                                        width={m.meta?.width}
                                        height={m.meta?.height}
                                        controls
                                        playsinline
                                        preload="none"
                                        muted={canLoop(m.src) || undefined}
                                        loop={canLoop(m.src) || undefined}
                                        data-loop={canLoop(m.src) ? '' : undefined}
                                        aria-label={m.alt || `${d.title} video`}
                                    ></video>
                                ) : (
                                    <a href={full} data-lightbox data-alt={altOf(m)} data-caption={m.caption} aria-label={`Enlarge: ${altOf(m)}`}>
                                        <Media item={m} alt={altOf(m)} sizes="(min-width: 800px) 560px, calc(100vw - 32px)" widths={[480, 800, 1200]} />
                                    </a>
                                )}
                                {m.caption && <figcaption>{m.caption}</figcaption>}
                            </figure>
                        </li>
                    ))}
                </ul>
            </section>
        )}

        {d.credits?.length > 0 && (
            <section>
                <h2>Credits</h2>
                <dl class="facts credits">
                    {d.credits.map((c: { name: string; role: string }) => <><dt>{c.role}</dt><dd>{c.name}</dd></>)}
                </dl>
            </section>
        )}

        {(prev || next) && (
            <nav class="pager" aria-label="More case studies">
                {prev ? <a class="prev" href={`/projects/${prev.id}/`}><span>Previous</span>&larr; {prev.title}</a> : <span></span>}
                {next ? <a class="next" href={`/projects/${next.id}/`}><span>Next</span>{next.title} &rarr;</a> : <span></span>}
            </nav>
        )}
    </div>

    <dialog id="lightbox" aria-label="Image viewer">
        <figure>
            <img alt="" />
            <figcaption></figcaption>
        </figure>
        <div class="lb-ui">
            <button type="button" data-prev aria-label="Previous image">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 2L4 8l6 6"/></svg>
            </button>
            <button type="button" data-next aria-label="Next image">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2l6 6-6 6"/></svg>
            </button>
            <form method="dialog">
                <button aria-label="Close">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
                </button>
            </form>
        </div>
    </dialog>
</article>

<script>
    // Lightbox: native <dialog>, arrow keys to move, Esc to close.
    const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
    if (dialog && links.length) {
        const img = dialog.querySelector('img')!;
        const caption = dialog.querySelector('figcaption')!;
        let index = 0;
        const show = (n: number) => {
            index = (n + links.length) % links.length;
            const a = links[index];
            img.src = a.href;
            img.alt = a.dataset.alt ?? '';
            caption.textContent = a.dataset.caption ?? '';
        };
        links.forEach((a, n) => a.addEventListener('click', e => {
            e.preventDefault();
            show(n);
            dialog.showModal();
        }));
        dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
        dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
        if (links.length < 2) dialog.querySelectorAll('[data-prev], [data-next]').forEach(b => b.remove());
        dialog.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft') show(index - 1);
            else if (e.key === 'ArrowRight') show(index + 1);
        });
        // A click on the backdrop closes it
        dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    }

    // itch.io embeds load only on request
    document.querySelectorAll<HTMLElement>('[data-embed]').forEach(box => {
        box.querySelector('button')?.addEventListener('click', () => {
            const frame = document.createElement('iframe');
            frame.src = box.dataset.embed!;
            frame.title = box.dataset.title ?? '';
            frame.allowFullscreen = true;
            box.replaceChildren(frame);
            box.classList.add('live');
        });
    });

    // Short loops play on their own unless the visitor prefers reduced motion
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLVideoElement>('video[data-loop]').forEach(v => v.play().catch(() => {}));
    }
</script>

<style>
    .cs { padding-bottom: var(--space-4); }
    .back { padding-block: var(--space-5) var(--space-3); font-size: var(--step--1); }
    .back a { color: var(--ink-2); }
    .back a:hover { color: var(--forest); }

    .tabline { display: flex; }
    .cs-tab {
        position: relative; margin-bottom: -2px; max-width: 100%;
        padding: var(--space-3) var(--space-5) var(--space-3);
        background: var(--board); border: 2px solid var(--outline); border-bottom: 0;
        border-radius: var(--radius) var(--radius) 0 0;
    }
    .cs-tab h1 { font-size: var(--step-4); letter-spacing: -0.015em; line-height: 1.1; }
    .cs-folder {
        background: var(--board); border: 2px solid var(--outline);
        border-radius: 0 var(--radius) var(--radius) var(--radius);
        padding: var(--space-5);
    }
    .lead { font-size: var(--step-1); line-height: 1.4; max-width: 60ch; margin-bottom: var(--space-5); }
    .cs-grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--space-5); align-items: start; }
    .cs-grid:not(:has(.hero)) { grid-template-columns: minmax(0, 1fr); }
    .hero { background: var(--paper); border-radius: 4px; overflow: hidden; }
    .hero img, .hero video { width: 100%; max-height: 72vh; object-fit: contain; }
    .hero video { aspect-ratio: var(--ratio); background: #000; }
    .card { position: sticky; top: calc(var(--header-h) + var(--space-4)); background: var(--paper); border-top: 2px solid var(--forest); padding: var(--space-4) var(--space-5); border-radius: 0 0 6px 6px; }
    .card:not(:has(*)) { display: none; }
    .links { display: flex; flex-direction: column; gap: var(--space-1); }

    .main { margin-top: var(--space-8); }
    .main > section { margin-bottom: var(--space-7); }
    .main h2 { margin-bottom: var(--space-4); }
    .main > section > .prose, .bullets, .iterations { max-width: 72ch; }
    .bullets { list-style: disc; padding-left: 1.25em; display: grid; gap: var(--space-2); }
    .iterations { display: grid; gap: var(--space-4); counter-reset: it; }
    .iterations li { border-left: 2px solid var(--rule-strong); padding-left: var(--space-4); }
    .iterations dl { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-1) var(--space-4); }
    .iterations dt { color: var(--ink-3); font-size: var(--step--1); line-height: 1.7; }
    .body { margin-top: var(--space-7); }
    .body :global(.prose > :first-child) { margin-top: 0; }

    .embed.game { aspect-ratio: 16 / 9; max-width: 960px; background: var(--board); border-radius: 6px; display: grid; place-items: center; }
    .embed.widget { max-width: 552px; min-height: 167px; background: var(--board); border-radius: 6px; display: grid; place-items: center; }
    .embed iframe { width: 100%; height: 100%; border: 0; }
    .embed.widget iframe { height: 167px; }

    .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); align-items: start; }
    .gallery figure { display: grid; gap: var(--space-2); }
    .gallery a { display: block; background: var(--board); border-radius: 4px; overflow: hidden; }
    .gallery a:hover { background: var(--forest-wash); }
    .gallery img, .gallery video { width: 100%; max-height: 520px; object-fit: contain; }
    .gallery video { background: #000; }
    figcaption { color: var(--ink-2); font-size: var(--step--1); max-width: 60ch; }

    .credits { max-width: 68ch; }

    .pager { display: flex; justify-content: space-between; gap: var(--space-5); margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--rule); }
    .pager a { display: flex; flex-direction: column; text-decoration: none; font-weight: 600; font-size: var(--step-1); color: var(--ink); max-width: 45%; }
    .pager a:hover { color: var(--forest); }
    .pager a span { font-weight: 400; font-size: var(--step--1); color: var(--ink-3); }
    .pager .next { text-align: right; margin-left: auto; }

    dialog { padding: 0; border: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; color: #fff; }
    dialog::backdrop { background: rgb(10 12 9 / 0.92); }
    dialog figure { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3); padding: 56px 16px 24px; }
    dialog img { max-width: 100%; max-height: calc(100dvh - 140px); object-fit: contain; }
    dialog figcaption { color: #e8eadf; max-width: 70ch; text-align: center; }
    .lb-ui button {
        position: fixed; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer;
        background: rgb(10 12 9 / 0.7); color: #fff; border: 2px solid #8b9482; border-radius: 50%;
    }
    .lb-ui button:hover { border-color: #fff; }
    .lb-ui svg { width: 16px; height: 16px; }
    .lb-ui [data-prev] { left: 12px; top: 50%; }
    .lb-ui [data-next] { right: 12px; top: 50%; }
    .lb-ui form { position: fixed; top: 12px; right: 12px; }
    .lb-ui form button { position: static; }
    dialog :focus-visible { outline-color: #a3c585; }

    @media (max-width: 900px) {
        .cs-grid { grid-template-columns: 1fr; }
        .gallery { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
        .cs-folder { padding: var(--space-4); }
        .cs-tab { padding: var(--space-2) var(--space-4); }
        .pager { flex-direction: column; }
        .pager a { max-width: none; }
        .pager .next { text-align: left; margin-left: 0; }
    }
</style>
