---
// Dev-only (injected by astro.config.mjs when running `astro dev`).
import Layout from '../layouts/Layout.astro';
---
<Layout title="Vault Admin" noindex>
    <style is:global> /* rows are built by JS, so scoped styles would miss them */
        .admin { max-width: 1100px; margin: 0 auto; padding: calc(var(--nav-h) + 2.5rem) var(--section-padding) 4rem; width: 100%; }
        .admin-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
        h1 { font-size: 2.2rem; text-transform: uppercase; letter-spacing: -0.01em; line-height: 1; }
        .sub { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.4rem; }
        .btn {
            font-family: inherit; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 0.6rem 1.2rem; cursor: pointer; border: 2px solid var(--border); box-shadow: 3px 3px 0 var(--border);
            background: var(--bg); color: var(--text-primary);
        }
        .btn.primary { background: var(--accent); color: var(--bg); }
        .btn:hover { transform: translate(-1px, -1px); }
        .actions { display: flex; gap: 0.6rem; }
        .status { min-height: 1.5rem; font-size: 0.85rem; font-weight: 600; color: var(--accent); margin-bottom: 1rem; }
        .status.err { color: #b3261e; }
        .tabs { display: flex; gap: 0; border-bottom: 2px solid var(--border); margin-bottom: 1rem; }
        .tab { font-family: inherit; background: none; border: 2px solid transparent; border-bottom: none; padding: 0.55rem 1rem; cursor: pointer; font-weight: 700; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.08em; color: var(--text-muted); }
        .tab[aria-selected="true"] { border-color: var(--border); background: var(--card-bg); color: var(--text-primary); margin-bottom: -2px; padding-bottom: calc(0.55rem + 2px); }
        .hint { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem; }
        .list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
        .row {
            display: grid; grid-template-columns: 1.5rem 1fr auto auto; gap: 0.85rem; align-items: center;
            background: var(--card-bg); border: 2px solid var(--border); padding: 0.6rem 0.85rem;
        }
        .row.private { opacity: 0.6; border-style: dashed; }
        .row.dragging { opacity: 0.3; }
        .row.over { box-shadow: 0 -4px 0 var(--accent); }
        .grip { cursor: grab; color: var(--text-muted); user-select: none; font-size: 1.1rem; line-height: 1; }
        .title { font-weight: 700; }
        .meta { font-size: 0.72rem; color: var(--text-muted); display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.15rem; align-items: center; }
        .disc { border: 1.5px solid var(--border); padding: 0 0.35rem; text-transform: uppercase; font-weight: 700; font-size: 0.6rem; letter-spacing: 0.06em; }
        .todo { color: #8a5a00; cursor: help; }
        .todo-list { font-size: 0.78rem; color: #8a5a00; margin: 0.35rem 0 0 1rem; }
        .file { font-size: 0.72rem; color: var(--accent); }
        .toggle { font-family: inherit; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.3rem 0.6rem; cursor: pointer; border: 2px solid var(--border); background: transparent; min-width: 6.5rem; }
        .toggle.on { background: var(--accent); color: var(--bg); }
    </style>

    <main class="admin">
        <div class="admin-head">
            <div>
                <h1>Vault</h1>
                <p class="sub">Local only. Changes save straight to <code>vault/</code>. <strong>Publish</strong> copies public items into the site.</p>
            </div>
            <div class="actions">
                <button class="btn" id="newBtn" type="button">+ New project</button>
                <button class="btn primary" id="publishBtn" type="button">Publish</button>
            </div>
        </div>
        <p class="status" id="status" role="status"></p>
        <div class="tabs" role="tablist" id="tabs"></div>
        <p class="hint">Drag rows to reorder. Dashed rows are private. Click a title to open the file in VS Code.</p>
        <ul class="list" id="list"></ul>
    </main>

    <script>
        type Item = { id: string; file: string; title?: string; name?: string; visibility?: string;
            featured?: boolean; order?: number; disciplines?: string[]; todo?: string[] };
        type Vault = Record<string, Item[]>;

        let vault: Vault = {};
        let current = 'projects';
        const $ = (id: string) => document.getElementById(id)!;

        function setStatus(msg: string, err = false) {
            const el = $('status');
            el.textContent = msg;
            el.classList.toggle('err', err);
        }

        async function api(path: string, body?: unknown) {
            const res = await fetch('/api/vault' + path, body === undefined ? undefined : {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || res.statusText);
            return data;
        }

        async function load() {
            try {
                vault = await api('/');
                renderTabs();
                renderList();
            } catch (e) {
                setStatus(`Couldn't read the vault: ${(e as Error).message}`, true);
            }
        }

        function renderTabs() {
            const tabs = $('tabs');
            tabs.innerHTML = '';
            for (const name of Object.keys(vault)) {
                const pub = vault[name].filter(i => i.visibility === 'public').length;
                const b = document.createElement('button');
                b.className = 'tab';
                b.type = 'button';
                b.setAttribute('role', 'tab');
                b.setAttribute('aria-selected', String(name === current));
                b.textContent = `${name} (${pub}/${vault[name].length})`;
                b.addEventListener('click', () => { current = name; renderTabs(); renderList(); });
                tabs.appendChild(b);
            }
        }

        function toggleButton(label: string, on: boolean, onClick: () => void) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'toggle' + (on ? ' on' : '');
            b.textContent = label;
            b.setAttribute('aria-pressed', String(on));
            b.addEventListener('click', onClick);
            return b;
        }

        async function patch(changes: { collection: string; id: string; patch: Record<string, unknown> }[]) {
            try {
                await api('/patch', changes);
                setStatus('Saved to vault. Publish to update the site.');
                await load();
            } catch (e) {
                setStatus(`Save failed: ${(e as Error).message}`, true);
            }
        }

        let dragId: string | null = null;

        function renderList() {
            const list = $('list');
            list.innerHTML = '';
            for (const item of vault[current] ?? []) {
                const li = document.createElement('li');
                li.className = 'row' + (item.visibility === 'public' ? '' : ' private');
                li.draggable = true;
                li.dataset.id = item.id;

                const grip = document.createElement('span');
                grip.className = 'grip';
                grip.textContent = '⋮⋮';
                grip.setAttribute('aria-hidden', 'true');

                const info = document.createElement('div');
                const title = document.createElement('a');
                title.className = 'title';
                title.href = 'vscode://file/' + item.file.replace(/\\/g, '/');
                title.textContent = item.title || item.name || item.id;
                const meta = document.createElement('div');
                meta.className = 'meta';
                for (const d of item.disciplines ?? []) {
                    const s = document.createElement('span');
                    s.className = 'disc';
                    s.textContent = d;
                    meta.appendChild(s);
                }
                const file = document.createElement('span');
                file.className = 'file';
                file.textContent = item.id;
                meta.appendChild(file);
                info.append(title, meta);
                if (item.todo?.length) {
                    const ul = document.createElement('ul');
                    ul.className = 'todo-list';
                    for (const t of item.todo) {
                        const tli = document.createElement('li');
                        tli.textContent = 'TODO: ' + t;
                        ul.appendChild(tli);
                    }
                    info.appendChild(ul);
                }

                const isPublic = item.visibility === 'public';
                const vis = toggleButton(isPublic ? 'Public' : 'Private', isPublic, () =>
                    patch([{ collection: current, id: item.id, patch: { visibility: isPublic ? 'private' : 'public' } }]));

                const featuredCell = document.createElement('span');
                if (current === 'projects') {
                    featuredCell.appendChild(toggleButton(item.featured ? '★ Featured' : 'Feature', !!item.featured, () =>
                        patch([{ collection: current, id: item.id, patch: { featured: !item.featured } }])));
                }

                li.append(grip, info, featuredCell, vis);

                li.addEventListener('dragstart', () => { dragId = item.id; li.classList.add('dragging'); });
                li.addEventListener('dragend', () => { dragId = null; li.classList.remove('dragging'); });
                li.addEventListener('dragover', e => { e.preventDefault(); li.classList.add('over'); });
                li.addEventListener('dragleave', () => li.classList.remove('over'));
                li.addEventListener('drop', e => {
                    e.preventDefault();
                    li.classList.remove('over');
                    if (!dragId || dragId === item.id) return;
                    const ids = vault[current].map(i => i.id).filter(id => id !== dragId);
                    ids.splice(ids.indexOf(item.id), 0, dragId);
                    patch(ids.map((id, i) => ({ collection: current, id, patch: { order: i + 1 } })));
                });

                list.appendChild(li);
            }
        }

        $('publishBtn').addEventListener('click', async () => {
            try {
                const { counts, missing } = await api('/publish', {});
                const summary = Object.entries(counts).map(([k, v]) => `${v} ${k}`).join(', ');
                setStatus(`Published: ${summary}.` + (missing.length ? ` Missing media: ${missing.join(', ')}` : ' Commit and push the site repo to go live.'), missing.length > 0);
            } catch (e) {
                setStatus(`Publish failed: ${(e as Error).message}`, true);
            }
        });

        $('newBtn').addEventListener('click', async () => {
            const title = prompt('Project title');
            if (!title) return;
            try {
                const { id } = await api('/new', { title });
                current = 'projects';
                setStatus(`Created vault/projects/${id}.md (private). Fill it in, then make it public.`);
                await load();
            } catch (e) {
                setStatus(`Couldn't create: ${(e as Error).message}`, true);
            }
        });

        load();
    </script>
</Layout>
