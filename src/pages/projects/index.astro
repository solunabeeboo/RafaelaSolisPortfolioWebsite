        body.edit-mode .strip-edit-btn { display: block; }
        body.edit-mode .strip-hint { display: none; }
        body.edit-mode .strip-header-tags { display: none; }
        /* Pull short-desc away from reorder+edit buttons so text stays centered */
        body.edit-mode .strip-short-desc { right: 14rem; }

        .strip-reorder-btns {
            display: none; position: absolute; right: 8rem; top: 50%;
