---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getProjects, projectMedia, featuredFor } from '../../lib/content';

export async function getStaticPaths() {
    const projects = await getProjects();
    return projects.map(p => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const media = projectMedia(entry);

// Pager walks the featured projects in her order
const featured = featuredFor(await getProjects());
const at = featured.findIndex(p => p.id === entry.id);
const pick = (p?: (typeof featured)[number]) => (p ? { id: p.id, title: p.data.title } : undefined);
const prev = at > 0 ? pick(featured[at - 1]) : undefined;
const next = at >= 0 && at < featured.length - 1 ? pick(featured[at + 1]) : undefined;

const cover = media.find(m => !m.video);
const ogImage = cover?.image
    ? (await getImage({ src: cover.image, width: 1200, format: 'jpeg' })).src
    : undefined;
---
<Layout
    title={`${d.title} | Rafaela Solís, Game Designer`}
    description={`${d.hook}${d.role ? ` Role: ${d.role}.` : ''}`}
    image={ogImage}
>
    <CaseStudy project={entry} media={media} prev={prev} next={next}>
        <Content slot="body" />
    </CaseStudy>
</Layout>
