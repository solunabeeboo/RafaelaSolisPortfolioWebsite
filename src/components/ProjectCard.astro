---
import type { Project } from '../lib/content';
import { projectMedia, isVideo } from '../lib/content';

interface Props { project: Project }
const { project: p } = Astro.props;
const thumb = p.data.image || projectMedia(p).find(m => !isVideo(m));
---
<a class="pcard" href={`/projects/${p.id}/`}>
    <div class="pcard-img" style={thumb ? `background-image: url('${encodeURI(thumb)}')` : undefined}></div>
    <div class="pcard-body">
        <h3 class="pcard-title">{p.data.title}</h3>
        {p.data.role && <p class="pcard-role">{p.data.role}</p>}
        <p class="pcard-hook">{p.data.hook}</p>
        <p class="pcard-meta">{[p.data.engine, p.data.status].filter(Boolean).join(' · ')}</p>
    </div>
</a>

<style>
    .pcard {
        display: flex; flex-direction: column; text-decoration: none; color: var(--text-primary);
        background: var(--card-bg); border: 2px solid var(--border); box-shadow: 4px 4px 0 var(--border);
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .pcard:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--border); }
    .pcard-img {
        aspect-ratio: 16 / 9; background: linear-gradient(135deg, var(--accent), var(--accent-sage));
        background-size: cover; background-position: center; border-bottom: 2px solid var(--border);
    }
    .pcard-body { padding: 1rem 1.15rem 1.2rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
    .pcard-title { font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.15; }
    .pcard-role { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); }
    .pcard-hook { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55; }
    .pcard-meta { font-size: 0.75rem; color: var(--text-muted); margin-top: auto; padding-top: 0.4rem; }
</style>
